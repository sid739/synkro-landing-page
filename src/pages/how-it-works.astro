---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Workflow from "../components/Workflow.astro";
import Discovery from "../components/Discovery.astro";
import Clearance from "../components/Clearance.astro";
import Cta from "../components/Cta.astro";
import { site, steps } from "../data/site";
import { breadcrumbLd } from "../data/schema";

const crumbs = [{ name: "How it works", href: "/how-it-works/" }];
const howToLd = {
  "@type": "HowTo",
  name: `How to clear a sync license with ${site.name}`,
  description: "Search catalogs, verify rights, automate negotiations, and execute licenses through a single workflow.",
  step: steps.map((s, i) => ({ "@type": "HowToStep", position: i + 1, name: `${s.title}: ${s.feature}`, text: s.body })),
};
---
<Base
  title="How sync licensing works on Synkro"
  description="Find music, verify rights, pitch clients, request sync, negotiate, draft the contract, pay out splits and get files: the eight steps of a sync license on Synkro."
  jsonLd={[breadcrumbLd(crumbs), howToLd]}
>
  <PageHero eyebrow="How it works" title='Sync <span class="hl">Anything.</span>' lede="Search catalogs, verify rights, automate negotiations, and execute licenses through a single workflow." crumbs={crumbs} />
  <Workflow />
  <Discovery />
  <Clearance />
  <Cta />
</Base>
