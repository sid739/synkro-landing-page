---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import Faq from "../../components/Faq.astro";
import Waitlist from "../../components/Waitlist.astro";
import { audiences, type Audience } from "../../data/site";
import { breadcrumbLd, faqLd } from "../../data/schema";

export function getStaticPaths() {
  return audiences.map((a) => ({ params: { slug: a.slug }, props: { a } }));
}

const { a } = Astro.props as { a: Audience };
const crumbs = [{ name: a.name, href: `/for/${a.slug}/` }];
const others = audiences.filter((o) => o.slug !== a.slug);
---
<Base title={a.metaTitle} description={a.metaDescription} jsonLd={[breadcrumbLd(crumbs), faqLd(a.faq)]}>
  <PageHero eyebrow={`For ${a.name.toLowerCase()}`} title={a.title} lede={a.intro} crumbs={crumbs}>
    <div class="ctas">
      <a class="btn btn-primary" href="#waitlist">Join the waitlist</a>
      <a class="btn btn-secondary" href="/how-it-works/">See how it works</a>
    </div>
  </PageHero>

  <section class="section ink" aria-labelledby="pain-title">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">What slows you down</p>
        <h2 id="pain-title">The work around the work.</h2>
      </div>
      <ol class="cards">
        {a.pains.map((p, i) => (
          <li><span class="num">{String(i + 1).padStart(2, "0")}</span><h3>{p.title}</h3><p>{p.body}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section band" aria-labelledby="gain-title">
    <div class="dots dots-tr"></div>
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">What changes with Synkro</p>
        <h2 id="gain-title">One workflow, start to finish.</h2>
      </div>
      <ul class="gains">
        {a.gains.map((g) => (<li><h3>{g.title}</h3><p>{g.body}</p></li>))}
      </ul>
    </div>
  </section>

  <Faq items={a.faq} title={`${a.name}: common questions`} />

  <section class="section more" aria-labelledby="more-title">
    <div class="wrap">
      <h2 id="more-title" class="eyebrow">Also built for</h2>
      <ul>{others.map((o) => <li><a href={`/for/${o.slug}/`}>{o.name} <span aria-hidden="true">→</span></a></li>)}</ul>
    </div>
  </section>

  <Waitlist />
</Base>

<style>
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; }
  .cards { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .cards li { border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 28px; display: grid; gap: 12px; align-content: start; }
  .cards .num { font-size: 40px; color: var(--accent-text); line-height: 1; }
  .cards p { color: var(--muted); }
  .gains { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .gains li { background: #000; color: #fff; border-radius: var(--radius-lg); padding: 30px; display: grid; gap: 12px; align-content: start; }
  .gains p { color: #b9b9c4; }
  .more { padding-block: 0 clamp(64px, 8vw, 104px); }
  .more ul { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 12px; margin-top: 18px; }
  .more a { display: inline-flex; align-items: center; gap: 10px; min-height: 52px; padding: 0 22px; border: 1.5px solid var(--line); border-radius: 999px; text-decoration: none; font-weight: 700; }
  .more a:hover { border-color: var(--fg); }
  @media (max-width: 900px) { .cards, .gains { grid-template-columns: 1fr; } }
</style>
