---
import Base from "../layouts/Base.astro";
import IntroFilm from "../components/IntroFilm.astro";
import Hero from "../components/Hero.astro";
import LogoStrip from "../components/LogoStrip.astro";
import BigMarquee from "../components/BigMarquee.astro";
import Doors from "../components/Doors.astro";
import Problem from "../components/Problem.astro";
import Workflow from "../components/Workflow.astro";
import Product from "../components/Product.astro";
import Pricing from "../components/Pricing.astro";
import Catalog from "../components/Catalog.astro";
import WhoItsFor from "../components/WhoItsFor.astro";
import Principles from "../components/Principles.astro";
import Cta from "../components/Cta.astro";
import Faq from "../components/Faq.astro";
import { homeFaq, site } from "../data/site";
import { faqLd, softwareLd } from "../data/schema";
---
<Base title="Music Licensing, in One Place" description={site.description} jsonLd={[softwareLd(), faqLd(homeFaq)]}>
  <IntroFilm slot="intro" />
  <Hero />
  <LogoStrip />
  <Doors />
  <BigMarquee rows={[["Film", "TV", "Ads", "Trailers", "Games", "Streaming"]]} />
  <Problem />
  <Workflow />
  <Product />
  <Catalog />
  <WhoItsFor />
  <Pricing />
  <Principles />
  <Cta />
  <Faq
    items={homeFaq}
    eyebrow="FAQ"
    track={9}
    title='Frequently Asked <span class="hl">Questions</span>'
    lede="Search, rights and clearance, answered."
  />
</Base>
