---
import Base from "../layouts/Base.astro";
import IntroFilm from "../components/IntroFilm.astro";
import Hero from "../components/Hero.astro";
import BigMarquee from "../components/BigMarquee.astro";
import SearchShowcase from "../components/SearchShowcase.astro";
import Workflow from "../components/Workflow.astro";
import Discovery from "../components/Discovery.astro";
import Clearance from "../components/Clearance.astro";
import Catalog from "../components/Catalog.astro";
import WhoItsFor from "../components/WhoItsFor.astro";
import Principles from "../components/Principles.astro";
import Cta from "../components/Cta.astro";
import Faq from "../components/Faq.astro";
import { homeFaq, site } from "../data/site";
import { faqLd, softwareLd } from "../data/schema";
---
<Base title="Music Licensing, in One Place" description={site.description} jsonLd={[softwareLd(), faqLd(homeFaq)]}>
  <IntroFilm slot="intro" />
  <Hero />
  <BigMarquee rows={[["Film", "TV", "Ads", "Trailers", "Games", "Streaming"], ["Search", "Clear", "Sign", "Deliver", "Get paid"]]} />
  <SearchShowcase />
  <Workflow />
  <Discovery />
  <Clearance />
  <Catalog />
  <WhoItsFor />
  <Principles />
  <Cta />
  <Faq
    items={homeFaq}
    eyebrow="FAQ"
    track={9}
    title='Frequently Asked <span class="hl">Questions</span>'
    lede="Everything you need to know about Synkro search, rights verification, and clearance workflow."
  />
</Base>
