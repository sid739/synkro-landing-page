---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Faq from "../components/Faq.astro";
import Cta from "../components/Cta.astro";
import { site, type Faq as FaqItem } from "../data/site";
import { breadcrumbLd, faqLd } from "../data/schema";
import { estimate, media, profiles, territories, terms, usd } from "../data/fees";

const crumbs = [{ name: "Sync fee estimator", href: "/sync-fee-estimator/" }];
const title = "Sync license fee estimator: how much does it cost to license a song?";
const description = "Estimate what it costs to license a song for an ad, film, TV series, trailer or game. Pick the media, how well known the track is, the territory and the term to see an indicative fee range.";

const groups = [
  { name: "profile", legend: "How well known is the track?", items: profiles },
  { name: "territory", legend: "Where will it be shown?", items: territories },
  { name: "term", legend: "For how long?", items: terms },
] as const;
const first = estimate(media[0]!, profiles[0]!, territories[0]!, terms[0]!);

const faq: FaqItem[] = [
  { q: "How much does it cost to license a song for an ad?", a: "For an online or social ad, a track by an emerging artist is often licensed for a few thousand dollars. A national TV commercial typically costs tens of thousands, and a well-known hit in a worldwide campaign can cost six or seven figures. The territory, term, exclusivity and how prominently the song is used all move the price." },
  { q: "Is the fee paid to one owner or several?", a: "Usually several. Using an existing recording needs a master license from its owner and a sync license from each publisher of the song. The total is commonly split evenly between the master side and the publishing side, often on most favoured nations (MFN) terms." },
  { q: "Why do estimates vary so much?", a: "Sync fees are negotiated case by case. Two uses of the same song can differ by an order of magnitude depending on the media, how long and where it runs, whether it is featured or in the background, and whether exclusivity is required." },
  { q: "How do I get a real quote?", a: "Send a license request with your media, territory, term and budget to every rights holder. On Synkro you can see who owns each share and send one request to all of them." },
];

const articleLd = {
  "@type": "WebApplication",
  name: "Sync license fee estimator",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description,
  url: new URL("/sync-fee-estimator/", site.url).href,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  publisher: { "@id": `${site.url}/#organization` },
};
---
<Base title={title} description={description} jsonLd={[articleLd, breadcrumbLd(crumbs), faqLd(faq)]}>
  <PageHero eyebrow="Free tool" title='Sync fee <span class="hl">estimator</span>' crumbs={crumbs}
    lede="What does it cost to license a song? Describe the use and get an indicative range in seconds." />

  <div class="wrap tool" data-estimator>
    <form class="controls" aria-label="Describe the use">
      <fieldset>
        <legend>What is the music for?</legend>
        <div class="media">
          {media.map((m, i) => (
            <label class="opt big">
              <input type="radio" name="media" value={m.id} checked={i === 0} />
              <span><b>{m.label}</b><small>{m.note}</small></span>
            </label>
          ))}
        </div>
      </fieldset>
      {groups.map((g) => (
        <fieldset data-group={g.name}>
          <legend>{g.legend}</legend>
          <div class="pills">
            {g.items.map((f, i) => (
              <label class="opt"><input type="radio" name={g.name} value={f.id} checked={i === 0} /><span>{f.label}</span></label>
            ))}
          </div>
        </fieldset>
      ))}
    </form>

    <aside class="result" aria-live="polite">
      <p class="eyebrow">Indicative total fee</p>
      <p class="range"><span data-low>{usd(first.low)}</span><span class="dash">–</span><span data-high>{usd(first.high)}</span></p>
      <div class="split">
        <div><small>Master side</small><b data-half>{usd(Math.round(first.low / 2))}–{usd(Math.round(first.high / 2))}</b></div>
        <div><small>Publishing side</small><b data-half>{usd(Math.round(first.low / 2))}–{usd(Math.round(first.high / 2))}</b></div>
      </div>
      <p class="hint" data-hint hidden></p>
      <p class="note" data-perpetual-note hidden>Film, TV and games are usually licensed worldwide and in perpetuity, so this range already assumes both.</p>
      <p class="fine">Illustrative only, not a quote. Real fees depend on the song, how it's used (featured or in the background, duration, edits), exclusivity and negotiation. Amounts in US dollars, before agency and legal costs.</p>
      <a class="btn btn-primary" href="/#join-licensee">Get real quotes on {site.name} <span aria-hidden="true">→</span></a>
    </aside>
  </div>

  <section class="wrap ranges" aria-labelledby="ranges-title">
    <h2 id="ranges-title">Typical sync fees by media</h2>
    <p class="lede">For a track by an emerging or independent artist: in one country for up to a year for ads, trailers and corporate video, and worldwide in perpetuity for film, TV and games. Read the full <a href="/sync-licensing-cost/">guide to sync licensing costs</a>.</p>
    <div class="table" role="table" aria-label="Typical sync fees by media">
      <div class="row head" role="row"><span role="columnheader">Media</span><span role="columnheader">Typical total fee</span></div>
      {media.map((m) => (
        <div class="row" role="row"><span role="cell">{m.label}</span><span role="cell">{usd(m.low)}–{usd(m.high)}</span></div>
      ))}
    </div>
  </section>

  <Faq items={faq} title="Sync fee questions" />
  <Cta />
</Base>

<style>
  .tool { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 56px); align-items: start; padding-bottom: clamp(56px, 7vw, 96px); }
  .controls { display: grid; gap: 28px; }
  fieldset { border: 0; padding: 0; margin: 0; display: grid; gap: 12px; }
  fieldset:disabled { opacity: .45; }
  legend { font-family: var(--font-display); font-weight: 800; letter-spacing: -.02em; font-size: 20px; margin-bottom: 12px; }
  .media { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .pills { display: flex; flex-wrap: wrap; gap: 8px; }
  .opt { position: relative; cursor: pointer; }
  .opt input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .opt span { display: grid; gap: 2px; min-height: 44px; align-content: center; padding: 10px 16px; border-radius: 999px; border: 1.5px solid var(--line); background: var(--surface); font-weight: 600; font-size: 15px; transition: border-color .15s, background-color .15s, color .15s; }
  .opt.big span { border-radius: var(--radius-md); padding: 14px 16px; height: 100%; }
  .opt.big small { color: var(--muted); font-weight: 500; font-size: 13px; }
  .opt:hover span { border-color: color-mix(in srgb, var(--accent) 50%, var(--line)); }
  .opt input:checked + span { border-color: var(--accent); background: var(--accent-soft); color: var(--accent-text); }
  .opt input:checked + span small { color: var(--accent-text); }
  .opt input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }

  .result { position: sticky; top: 96px; display: grid; gap: 16px; padding: clamp(24px, 3vw, 36px); border-radius: var(--radius-lg); background: #000; color: #fff; --muted: #a8a8b4; }
  .result .eyebrow { color: #8b7dff; }
  .range { font-family: var(--font-display); font-weight: 850; letter-spacing: -.045em; font-size: clamp(36px, 4.2vw, 56px); line-height: 1; font-variant-numeric: tabular-nums; display: flex; flex-wrap: wrap; align-items: baseline; }
  .range .dash { margin-inline: .14em; color: #8b7dff; }
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .split div { display: grid; gap: 4px; padding: 12px 14px; border-radius: 12px; background: #0d0d11; border: 1px solid #26262e; }
  .split small { color: var(--muted); font-size: 12px; }
  .split b { font-variant-numeric: tabular-nums; font-size: 15px; }
  .hint, .note { font-size: 14px; color: #d6d6de; }
  .hint[hidden], .note[hidden] { display: none; }
  .fine { font-size: 13px; color: var(--muted); }
  .result .btn { justify-self: start; }

  .ranges { display: grid; gap: 20px; padding-bottom: clamp(56px, 7vw, 96px); }
  .ranges h2 { font-size: clamp(30px, 3.4vw, 44px); }
  .ranges .lede a { color: var(--accent-text); text-underline-offset: 3px; }
  .table { display: grid; border-top: 1px solid var(--line); max-width: 760px; }
  .row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--line); }
  .row span:last-child { font-variant-numeric: tabular-nums; font-weight: 700; }
  .row.head span { font-family: var(--font-display); font-weight: 700; font-size: 12px; letter-spacing: .18em; text-transform: uppercase; color: var(--muted); }

  @media (max-width: 960px) { .tool { grid-template-columns: minmax(0, 1fr); } .result { position: static; } }
  @media (max-width: 560px) { .media { grid-template-columns: minmax(0, 1fr); } }
</style>

<script>
  import { estimate, media, profiles, territories, terms, usd } from "../data/fees";
  const root = document.querySelector<HTMLElement>("[data-estimator]");
  if (root) {
    const form = root.querySelector("form")!;
    const pick = <T extends { id: string }>(list: T[], name: string) => list.find((x) => x.id === new FormData(form).get(name)) ?? list[0]!;
    const $ = (sel: string) => root.querySelector<HTMLElement>(sel)!;
    const update = () => {
      const m = pick(media, "media"), profile = pick(profiles, "profile");
      const r = estimate(m, profile, pick(territories, "territory"), pick(terms, "term"));
      $("[data-low]").textContent = usd(r.low);
      $("[data-high]").textContent = usd(r.high);
      root.querySelectorAll<HTMLElement>("[data-half]").forEach((el) => { el.textContent = `${usd(Math.round(r.low / 2))}–${usd(Math.round(r.high / 2))}`; });
      const hint = $("[data-hint]");
      hint.textContent = profile.hint ?? ""; hint.hidden = !profile.hint;
      $("[data-perpetual-note]").hidden = !m.perpetual;
      for (const g of ["territory", "term"]) root.querySelector<HTMLFieldSetElement>(`[data-group="${g}"]`)!.disabled = !!m.perpetual;
    };
    form.addEventListener("change", update);
    update();
  }
</script>
