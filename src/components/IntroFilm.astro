---
// The homepage opens on a short, muted brand film that loops, filling the screen above the top bar
// (the bar comes into view, and then sticks, as the visitor scrolls past). Source: tools/intro-film.
// Large or high-resolution screens get the 4K version; phones get a 1080x1920 cut.
---
<section class="film" aria-label="Introduction film" data-film>
  <video muted loop playsinline preload="auto" poster="/intro/poster.jpg" aria-describedby="film-desc" data-video>
    <source src="/intro/synkro-intro-4k.mp4" type="video/mp4" media="(min-aspect-ratio: 4/5) and (min-width: 1280px) and (min-resolution: 1.5dppx), (min-aspect-ratio: 4/5) and (min-width: 2400px)" />
    <source src="/intro/synkro-intro.mp4" type="video/mp4" media="(min-aspect-ratio: 4/5)" />
    <source src="/intro/synkro-intro-portrait.mp4" type="video/mp4" />
    <source src="/intro/synkro-intro.webm" type="video/webm" media="(min-aspect-ratio: 4/5)" />
    <source src="/intro/synkro-intro-portrait.webm" type="video/webm" />
  </video>
  <p id="film-desc" class="sr-only">A 10-second film with no sound. Film, over a cinema audience in 3D glasses. TV, over the New York skyline at dusk. Ads, over cheerleaders in a white studio. Trailers, over an aerial of a mountain-top building above the clouds. Games, over a first-person view down a gun sight. Streaming, over a camera monitor on set. Then, over an overhead shot of a hand on a guitar beside headphones, cassettes and a record player: “We help you license any music, from anywhere in the world,” and “Sync Anything.”</p>
  <a class="skip-intro" href="#hero">Skip intro <span aria-hidden="true">↓</span></a>
</section>

<style>
  .film { position: relative; height: 100vh; height: 100svh; min-height: 420px; background: #050508; overflow: hidden; }
  video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  /* The film pops up as the page opens. */
  @media (prefers-reduced-motion: no-preference) {
    video { animation: film-in .9s cubic-bezier(.2, .7, .2, 1) both; }
    @keyframes film-in { from { opacity: 0; transform: scale(1.06); } }
  }
  .film::after { content: ""; position: absolute; inset: auto 0 0; height: 120px; background: linear-gradient(to top, rgba(5, 5, 8, .7), transparent); pointer-events: none; }
  .skip-intro { position: absolute; z-index: 1; right: max(var(--gutter-r), calc((100% - var(--max)) / 2 + 16px)); bottom: 20px; min-height: 44px; display: inline-flex; align-items: center; gap: 8px;
    color: #fff; font-size: 15px; font-weight: 700; text-underline-offset: 5px; }
</style>

<script>
  // Plays only while the film is on screen, and never for visitors who ask for reduced motion.
  const film = document.querySelector<HTMLElement>("[data-film]");
  const video = film?.querySelector<HTMLVideoElement>("[data-video]");
  if (film && video) {
    const reduce = matchMedia("(prefers-reduced-motion: reduce)");
    const portrait = matchMedia("(max-aspect-ratio: 4/5)");
    const setPoster = () => { video.poster = portrait.matches ? "/intro/poster-portrait.jpg" : "/intro/poster.jpg"; };
    let visible = true;
    video.muted = true;                                // some browsers only autoplay when the property is set
    const sync = () => {
      if (visible && !reduce.matches && !document.hidden) video.play().catch(() => {});
      else video.pause();
    };
    setPoster();
    portrait.addEventListener("change", setPoster);
    reduce.addEventListener("change", sync);
    document.addEventListener("visibilitychange", sync);
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; sync(); }, { threshold: 0.2 }).observe(film);
  }
</script>
