---
// The homepage opens on a short, muted brand film that plays once, full screen, over the site; when it
// ends (or the visitor skips it) it fades away and leaves the page as it always was. It plays once per
// browser session, and not at all for visitors who ask for reduced motion. Source: tools/intro-film.
// Large or high-resolution screens get the 4K version; phones get a 1080x1920 cut.
---
<script is:inline>
  // Decide before the rest of the page is drawn, so the site never flashes up under the film.
  try {
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches && !sessionStorage.getItem("synkro-intro-seen")) {
      document.documentElement.classList.add("intro");
    }
  } catch {}
</script>
<section class="film" aria-label="Introduction film" data-film>
  <video muted playsinline preload="auto" aria-describedby="film-desc" data-video>
    <source src="/intro/synkro-intro-4k.mp4" type="video/mp4" media="(min-aspect-ratio: 4/5) and (min-width: 1280px) and (min-resolution: 1.5dppx), (min-aspect-ratio: 4/5) and (min-width: 2400px)" />
    <source src="/intro/synkro-intro.mp4" type="video/mp4" media="(min-aspect-ratio: 4/5)" />
    <source src="/intro/synkro-intro-portrait.mp4" type="video/mp4" />
    <source src="/intro/synkro-intro.webm" type="video/webm" media="(min-aspect-ratio: 4/5)" />
    <source src="/intro/synkro-intro-portrait.webm" type="video/webm" />
  </video>
  <p id="film-desc" class="sr-only">A 10-second film with no sound. Film, over a cinema audience in 3D glasses. TV, over the New York skyline at dusk. Ads, over cheerleaders in a white studio. Trailers, over an aerial of a mountain-top building above the clouds. Games, over a first-person view down a gun sight. Streaming, over a camera monitor on set. Then, over an overhead shot of a hand on a guitar beside headphones, cassettes and a record player: “We help you license any music, from anywhere in the world,” and “Sync Anything.”</p>
  <button class="skip-intro" type="button" data-skip>Skip intro <span aria-hidden="true">→</span></button>
</section>

<style>
  .film { display: none; }
  :global(html.intro) { overflow: hidden; }
  :global(html.intro) .film { display: block; position: fixed; inset: 0; z-index: 100; background: #050508; transition: opacity .7s ease; }
  .film.leaving { opacity: 0; pointer-events: none; }
  video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; animation: film-in .9s cubic-bezier(.2, .7, .2, 1) both; }
  @keyframes film-in { from { opacity: 0; transform: scale(1.06); } }
  .film::after { content: ""; position: absolute; inset: auto 0 0; height: 120px; background: linear-gradient(to top, rgba(5, 5, 8, .6), transparent); pointer-events: none; }
  .skip-intro { position: absolute; z-index: 1; right: max(var(--gutter-r), calc((100% - var(--max)) / 2 + 16px)); bottom: max(20px, env(safe-area-inset-bottom, 0px)); min-height: 44px; display: inline-flex; align-items: center; gap: 8px;
    padding: 0 4px; border: 0; background: none; cursor: pointer; color: #fff; font: 700 15px var(--font-body); text-decoration: underline; text-underline-offset: 5px; }
  .skip-intro:focus-visible { outline: 2px solid #fff; outline-offset: 4px; border-radius: 4px; }
</style>

<script>
  // Plays the film once, then hands over to the page. If it cannot start or stalls (a slow connection,
  // or autoplay blocked as in iPhone Low Power Mode), the page is shown instead of a stuck screen.
  const root = document.documentElement;
  const film = document.querySelector<HTMLElement>("[data-film]");
  const video = film?.querySelector<HTMLVideoElement>("[data-video]");
  if (film && video && root.classList.contains("intro")) {
    let done = false, watchdog = 0;
    // The page behind the film stays out of keyboard and screen-reader reach until it is shown.
    const behind = [...document.body.children].filter((el): el is HTMLElement => el instanceof HTMLElement && el !== film && el.tagName !== "SCRIPT");
    behind.forEach((el) => (el.inert = true));
    const finish = () => {
      if (done) return;
      done = true;
      clearTimeout(watchdog);
      try { sessionStorage.setItem("synkro-intro-seen", "1"); } catch {}
      behind.forEach((el) => (el.inert = false));
      film.classList.add("leaving");
      setTimeout(() => {
        root.classList.remove("intro");
        video.pause();
        video.querySelectorAll("source").forEach((s) => s.remove());
        video.load();                                  // releases the film
      }, 700);
    };
    // Give up if nothing plays for a few seconds.
    const arm = (ms: number) => { clearTimeout(watchdog); watchdog = window.setTimeout(finish, ms); };
    video.muted = true;                                // some browsers only autoplay when the property is set
    video.addEventListener("playing", () => clearTimeout(watchdog));
    video.addEventListener("waiting", () => arm(3000));
    video.addEventListener("ended", finish);
    film.querySelector("[data-skip]")?.addEventListener("click", finish);
    addEventListener("keydown", (e) => { if (e.key === "Escape") finish(); });
    document.addEventListener("visibilitychange", () => {
      if (done) return;
      if (document.hidden) { clearTimeout(watchdog); video.pause(); }
      else { arm(4000); video.play().catch(finish); }
    });
    arm(4000);
    video.play().catch(finish);
  }
</script>
