---
import type { Feature } from "../data/site";
interface Props { id: string; part: string; title: string; accent: string; lede: string; features: Feature[]; tone?: "plain" | "ink" }
const { id, part, title, accent, lede, features, tone = "plain" } = Astro.props;
---
<section class:list={["section", "platform", { ink: tone === "ink" }]} id={id} aria-labelledby={`${id}-title`}>
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">{part}</p>
      <h2 id={`${id}-title`}>{title} <span class="hl">{accent}</span></h2>
      <p class="lede">{lede}</p>
    </div>
    <div class="grid">
      {features.map((f) => (
        <article class:list={["card", { wide: f.wide }]}>
          <div class="text">
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </div>
          <dl class="ui" aria-label="Example">
            {f.rows.map((r) => <div><dt>{r.label}</dt><dd>{r.value}</dd></div>)}
          </dl>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: clamp(24px, 2.6vw, 32px); display: grid; grid-template-rows: auto 1fr; gap: 24px; box-shadow: var(--shadow); }
  .card.wide { grid-column: span 2; }
  .text { display: grid; gap: 10px; align-content: start; }
  .text h3 { font-size: clamp(22px, 2.2vw, 28px); }
  .text p { color: var(--muted); max-width: 46ch; }
  .ui { align-self: end; display: grid; gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: var(--radius-md); overflow: hidden; }
  .ui div { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 12px 16px; background: var(--surface-2); font-size: 14px; }
  .ui dt { color: var(--muted); }
  .ui dd { font-weight: 700; text-align: right; overflow-wrap: anywhere; min-width: 0; }
  .ui div:last-child dd { color: var(--accent-text); }
  @media (max-width: 960px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 620px) { .grid { grid-template-columns: 1fr; } .card.wide { grid-column: auto; } }
</style>
