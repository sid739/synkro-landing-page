---
import { advisor, team } from "../data/site";
interface Props { headingLevel?: "h2" | "h1" }
const { headingLevel = "h2" } = Astro.props;
const Heading = headingLevel;
---
<section class="section band" id="team" aria-labelledby="team-title">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Leadership</p>
      <Heading id="team-title">We've run sync from both sides of the table.</Heading>
      <p class="lede">Record label, music tech, a career music supervisor, AI research and finance, under one roof.</p>
    </div>
    <ul class="people">
      {team.map((p) => (
        <li>
          <span class="ring"><img src={p.photo} alt={`Portrait of ${p.name}`} width="320" height="320" loading="lazy" decoding="async" /></span>
          <h3>{p.name}</h3>
          <p class="role">{p.role}</p>
          <p class="bio">{p.bio}</p>
        </li>
      ))}
    </ul>
    <p class="advisor"><span class="eyebrow">Advisor</span> <strong>{advisor.name}</strong> {advisor.role}</p>
  </div>
</section>

<style>
  .people { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .people li { background: #000; color: #fff; border-radius: var(--radius-lg); padding: 30px 24px; display: grid; justify-items: center; text-align: center; gap: 8px; align-content: start; }
  .ring { width: 156px; height: 156px; border-radius: 50%; padding: 4px; border: 2px solid #7d6ef7; margin-bottom: 14px; }
  .ring img { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; transform: scale(1.1); clip-path: circle(45%); }
  .people h3 { font-size: 22px; }
  .role { font-family: var(--font-display); font-weight: 700; font-size: 12px; letter-spacing: .18em; text-transform: uppercase; color: #8b7dff; }
  .bio { color: #b9b9c4; font-size: 15px; line-height: 1.55; margin-top: 6px; }
  .advisor { margin-top: 20px; display: inline-flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; background: #000; color: #fff; border-radius: 999px; padding: 16px 28px; }
  .advisor .eyebrow { color: #a8a8b4; }
  .advisor strong { font-family: var(--font-display); font-weight: 850; letter-spacing: -.03em; font-size: 20px; }
  @media (max-width: 960px) { .people { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .people { grid-template-columns: 1fr; } .advisor { border-radius: var(--radius-lg); } }
</style>
