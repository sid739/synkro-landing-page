---
import { problems } from "../data/site";
---
<section class="section" aria-labelledby="problem-title">
  <div class="dots dots-tr"></div>
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">The problem</p>
      <h2 id="problem-title">Music licensing still runs <span class="hl">on emails and spreadsheets.</span></h2>
      <p class="lede">Every step breaks the next one, turning simple placements into 6–8 week bottlenecks.</p>
    </div>
    <ol class="list">
      {problems.map((p, i) => (
        <li>
          <span class="num">{String(i + 1).padStart(2, "0")}</span>
          <h3>{p.title}</h3>
          <p>{p.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .list { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 28px; }
  .list li { display: grid; gap: 14px; align-content: start; }
  .list .num { font-size: clamp(48px, 5vw, 68px); line-height: 1; color: var(--accent-text); padding-bottom: 22px; border-bottom: 1px solid var(--line); }
  .list p { color: var(--muted); }
  @media (max-width: 900px) { .list { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 48px; } }
  @media (max-width: 520px) { .list { grid-template-columns: 1fr; } }
</style>
