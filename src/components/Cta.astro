---
import { demoHref, earlyAccessHref } from "../data/site";
---
<section class="section band cta" id="early-access" aria-labelledby="cta-title">
  <div class="dots dots-tr"></div>
  <div class="dots dots-bl"></div>
  <div class="wrap inner" data-reveal>
    <p class="eyebrow">Infrastructure for modern licensing</p>
    <h2 id="cta-title">We aren't just building a bigger catalog. <span class="hl">We're building the infrastructure sync always needed.</span></h2>
    <div class="ctas">
      <a class="btn btn-primary" href={earlyAccessHref}>Request Early Access <span aria-hidden="true">→</span></a>
      <a class="btn btn-secondary" href={demoHref}>Book a Live Demo</a>
    </div>
    <p class="note">Because every deal, song, rightsholder, and commercial scenario is unique.</p>
  </div>
</section>

<style>
  .inner { display: grid; justify-items: center; text-align: center; gap: 26px; }
  .inner h2 { font-size: clamp(38px, 5.4vw, 76px); max-width: 22ch; }
  .ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 8px; }
  .note { color: var(--on-band-muted); font-size: 18px; }
</style>
