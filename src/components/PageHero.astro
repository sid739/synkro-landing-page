---
export type Crumb = { name: string; href: string };
interface Props { eyebrow: string; title: string; lede?: string; crumbs: Crumb[] }
const { eyebrow, title, lede, crumbs } = Astro.props;
---
<section class="page-hero section" aria-labelledby="page-title">
  <div class="wrap">
    <nav aria-label="Breadcrumb">
      <ol class="crumbs">
        <li><a href="/">Home</a></li>
        {crumbs.map((c, i) => <li>{i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.href}>{c.name}</a>}</li>)}
      </ol>
    </nav>
    <p class="eyebrow">{eyebrow}</p>
    <h1 id="page-title" set:html={title} />
    {lede && <p class="lede">{lede}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero { padding-block: clamp(40px, 6vw, 72px) clamp(56px, 7vw, 96px); }
  .wrap { display: grid; gap: 24px; justify-items: start; }
  nav { margin-bottom: 20px; }
  h1 { font-size: clamp(46px, 7.2vw, 104px); max-width: 15ch; }
</style>
