---
import { catalogStats, labels } from "../data/site";
import Constellation from "./Constellation.astro";
import Artists from "./Artists.astro";
---
<section class="section" id="catalog" aria-labelledby="catalog-title">
  <div class="dots dots-tr"></div>
  <div class="wrap">
    <div class="section-head" data-reveal>
      <p class="eyebrow">What's in here</p>
      <h2 id="catalog-title">A catalog you can search like you talk. <span class="hl">Recorded between 1956 and this Tuesday</span></h2>
    </div>
  </div>

  <Artists />

  <div class="marquee" aria-label="Labels and publishers in the catalog" data-reveal>
    <ul class="track">
      {[...labels, ...labels].map((l, i) => (
        <li aria-hidden={i >= labels.length ? "true" : undefined}><img src={`/labels/${l.file}`} alt={i < labels.length ? l.name : ""} height="44" loading="lazy" decoding="async" /></li>
      ))}
    </ul>
  </div>

  <div class="wrap">
    <Constellation />
    <dl class="stats" data-play>
      {catalogStats.map((s, i) => (
        <div class:list={["a", { wide: s.wide }]} style={`--i: ${i}`}>
          <dt>{s.label}</dt>
          <dd class="num" data-count={s.value} data-suffix={s.suffix}>{s.text ?? `${s.value!.toLocaleString("en-US")}${s.suffix ?? ""}`}</dd>
          <dd class="body">{s.body}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .marquee { overflow: hidden; border-block: 1px solid var(--line); padding-block: 28px; mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .track { list-style: none; padding: 0; display: flex; align-items: center; gap: 72px; width: max-content; animation: scroll 55s linear infinite; }
  .marquee:hover .track { animation-play-state: paused; }
  .track img { height: 44px; width: auto; max-width: none; filter: brightness(0); opacity: .75; }
  :global(:root[data-theme="dark"]) .track img { filter: none; }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme="light"])) .track img { filter: none; } }
  @keyframes scroll { to { transform: translateX(calc(-50% - 36px)); } }

  .stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; margin-top: clamp(40px, 5vw, 64px); }
  .stats > div { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 28px; display: flex; flex-direction: column; gap: 8px; box-shadow: var(--shadow); }
  .stats .wide { grid-column: span 2; }
  .stats dt { order: 1; font-family: var(--font-display); font-weight: 700; font-size: 12px; letter-spacing: .18em; text-transform: uppercase; color: var(--muted); }
  /* The heaviest weight, thickened a touch further by an outline in the same colour. */
  .stats .num { order: 2; font-size: clamp(40px, 4.4vw, 68px); line-height: 1; color: var(--accent-text); font-weight: 900; font-stretch: 110%; -webkit-text-stroke: .025em currentColor; paint-order: stroke fill; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .stats > div:not(.wide) .num { font-size: clamp(34px, 3vw, 46px); }
  .stats .body { order: 3; color: var(--muted); font-size: 15px; max-width: 46ch; }

  @media (max-width: 960px) { .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .stats { grid-template-columns: 1fr; } .stats .wide { grid-column: auto; } }
  @media (prefers-reduced-motion: reduce) { .track { animation: none; flex-wrap: wrap; width: auto; justify-content: center; row-gap: 28px; } .track li[aria-hidden] { display: none; } }
</style>
