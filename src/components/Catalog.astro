---
import { artists, catalogStats, labels } from "../data/site";
---
<section class="section" id="catalog" aria-labelledby="catalog-title">
  <div class="dots dots-tr"></div>
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">What's in the catalog</p>
      <h2 id="catalog-title">A catalog you can search like you talk. <span class="hl">Recorded between 1956 and this Tuesday.</span></h2>
    </div>
  </div>

  <div class="marquee" aria-label="Labels and publishers on Synkro">
    <ul class="track">
      {[...labels, ...labels].map((l, i) => (
        <li aria-hidden={i >= labels.length ? "true" : undefined}><img src={`/labels/${l.file}`} alt={i < labels.length ? l.name : ""} height="44" loading="lazy" decoding="async" /></li>
      ))}
    </ul>
  </div>

  <div class="wrap">
    <dl class="stats">
      {catalogStats.map((s) => (
        <div class:list={{ wide: "wide" in s && s.wide }}>
          <dt>{s.label}</dt>
          <dd class="num">{s.value}</dd>
          <dd class="body">{s.body}</dd>
        </div>
      ))}
    </dl>

    <div class="artists">
      <p class="eyebrow">Artists and writers in the catalog</p>
      <ul>{artists.map((a) => <li><strong>{a.name}</strong><span>{a.genre}</span></li>)}</ul>
      <p class="note">Not every name is a direct artist relationship. On some songs we work with the co-writers rather than the performing artist.</p>
    </div>
  </div>
</section>

<style>
  .marquee { overflow: hidden; border-block: 1px solid var(--line); padding-block: 26px; mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .track { list-style: none; padding: 0; display: flex; align-items: center; gap: 64px; width: max-content; animation: scroll 50s linear infinite; }
  .marquee:hover .track { animation-play-state: paused; }
  .track img { height: 44px; width: auto; max-width: none; filter: var(--logo-filter, brightness(0)); opacity: .8; }
  :global(:root[data-theme="dark"]) .track img { filter: none; }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme="light"])) .track img { filter: none; } }
  @keyframes scroll { to { transform: translateX(calc(-50% - 32px)); } }

  .stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; margin-top: clamp(40px, 5vw, 64px); }
  .stats > div { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 26px; display: flex; flex-direction: column; gap: 6px; box-shadow: var(--shadow); }
  .stats .wide { grid-column: span 2; }
  .stats dt { order: 2; font-weight: 800; font-family: var(--font-display); letter-spacing: -.02em; font-size: 18px; }
  .stats .num { order: 1; font-size: clamp(36px, 4vw, 60px); line-height: 1; color: var(--accent-text); font-stretch: 110%; white-space: nowrap; }
  .stats > div:not(.wide) .num { font-size: clamp(32px, 3vw, 44px); }
  .stats .body { order: 3; color: var(--muted); font-size: 15px; }

  .artists { margin-top: clamp(40px, 5vw, 64px); display: grid; gap: 18px; }
  .artists ul { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .artists li { display: inline-flex; align-items: baseline; gap: 10px; padding: 12px 18px; border: 1px solid var(--line); border-radius: 999px; background: var(--surface); }
  .artists strong { font-family: var(--font-display); font-weight: 800; letter-spacing: -.03em; font-size: 18px; }
  .artists span { color: var(--muted); font-size: 13px; }
  .note { color: var(--faint); font-size: 14px; }

  @media (max-width: 960px) { .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .stats { grid-template-columns: 1fr; } .stats .wide { grid-column: auto; } }
  @media (prefers-reduced-motion: reduce) { .track { animation: none; flex-wrap: wrap; width: auto; justify-content: center; } .track li[aria-hidden] { display: none; } }
</style>
