---
import { ownershipRing } from "../lib/ring";
import { SEG, syncSegments as segments } from "../data/sync";

// An editing timeline: footage on V1, the matched track on A1, and a playhead that sweeps across both,
// with the music swelling into every cut. Each cut while playing is announced as a "sync:cut" event, which the hero headline follows.
---
<figure class="sync" data-sync data-seg={SEG} aria-label="Example: footage for film, TV, ads, trailers, games and streaming, each cut to a matched track whose rights holders are shown">
  <div class="bar" aria-hidden="true">
    <span class="lights"><i></i><i></i><i></i></span>
    <span class="name">Synkro · Untitled spot</span>
    <span class="tc" data-tc>00:00:00</span>
  </div>

  <div class="screen">
    <video muted loop playsinline preload="none" poster="/hero/sync-reel.jpg" aria-hidden="true" data-reel>
      <source src="/hero/sync-reel.mp4" type="video/mp4" />
      <source src="/hero/sync-reel.webm" type="video/webm" />
    </video>
    <span class="cat" data-cat>{segments[0].cat}</span>
    <span class="example">Example</span>
    <span class="lock" data-lock aria-hidden="true"><svg viewBox="0 0 12 12"><path d="M2 6.5l2.5 2.5L10 3.5" /></svg>In sync</span>
  </div>

  <div class="tracks" aria-hidden="true">
    <div class="labels"><span>V1</span><span>A1</span></div>
    <div class="lanes">
      <div class="lane v">
        {segments.map((s, i) => <span class:list={["clip", { on: i === 0 }]} style={`background-image: url(/hero/${s.clip}.jpg)`} data-clip><b>{s.cat}</b></span>)}
      </div>
      <div class="lane a">
        <canvas data-wave></canvas>
      </div>
      <i class="playhead" data-playhead></i>
    </div>
  </div>

  <ol class="now" aria-label="Matched tracks">
    {segments.map((s, i) => (
      <li class:list={["match", { on: i === 0 }]} data-match>
        <span class="play" aria-hidden="true"><svg viewBox="0 0 12 12"><path d="M3 1.5v9l7.5-4.5z" /></svg></span>
        <span class="d"><b>{s.track}</b><small>{s.cat} · {s.bpm} BPM · {s.key}</small></span>
        <span class:list={["badge", { one: s.holders === 1 }]}>{s.holders === 1 ? "One-stop" : `${s.holders} holders`}</span>
        <svg class="ring" viewBox="0 0 30 30" role="img" aria-label={`${s.holders} rights ${s.holders === 1 ? "holder" : "holders"}`} set:html={ownershipRing(s.holders)} />
      </li>
    ))}
  </ol>
</figure>

<style>
  .sync { margin: 0; display: grid; gap: 12px; padding: 12px; border-radius: var(--radius-lg); background: var(--surface); border: 1px solid var(--line);
    box-shadow: 0 30px 80px -30px rgba(40, 25, 140, .45), 0 0 0 1px color-mix(in srgb, var(--accent) 10%, transparent); }
  .bar { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 12px; padding: 2px 4px 0; font-size: 12px; color: var(--muted); }
  .lights { display: flex; gap: 6px; }
  .lights i { width: 10px; height: 10px; border-radius: 50%; background: var(--line); }
  .lights i:first-child { background: #ff5f57; } .lights i:nth-child(2) { background: #febc2e; } .lights i:last-child { background: #28c840; }
  .name { font-weight: 700; color: var(--fg); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .tc { font: 600 12px/1 ui-monospace, "SFMono-Regular", Menlo, monospace; font-variant-numeric: tabular-nums; padding: 5px 8px; border-radius: 6px; background: var(--surface-2); color: var(--fg); }

  .screen { position: relative; aspect-ratio: 16 / 9; border-radius: 14px; overflow: hidden; background: #050508; }
  video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .screen::after { content: ""; position: absolute; inset: 0; background: #fff; opacity: 0; pointer-events: none; }
  .sync.cut .screen::after { animation: flash .35s ease-out; }
  @keyframes flash { from { opacity: .35; } to { opacity: 0; } }
  .cat, .example, .lock { position: absolute; font: 700 12px/1 var(--font-body); color: #fff; border-radius: 999px; padding: 7px 11px; backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }
  .cat { left: 12px; bottom: 12px; background: rgba(84, 67, 216, .85); font-size: 14px; letter-spacing: .02em; }
  .example { right: 12px; top: 12px; background: rgba(5, 5, 8, .45); font-weight: 600; }
  .lock { right: 12px; bottom: 12px; display: inline-flex; align-items: center; gap: 6px; background: rgba(5, 5, 8, .55); opacity: 0; transform: translateY(6px); transition: opacity .25s, transform .25s; }
  .lock svg { width: 12px; height: 12px; fill: none; stroke: #8fffb0; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .sync.cut .lock { opacity: 1; transform: none; }

  .tracks { display: grid; grid-template-columns: 26px 1fr; gap: 8px; }
  .labels { display: grid; grid-template-rows: 44px 52px; gap: 6px; align-items: center; font: 700 11px/1 var(--font-body); color: var(--faint); }
  .lanes { position: relative; display: grid; grid-template-rows: 44px 52px; gap: 6px; }
  .lane { position: relative; border-radius: 8px; background: var(--surface-2); overflow: hidden; }
  .lane.v { display: grid; grid-template-columns: repeat(6, 1fr); gap: 2px; padding: 2px; }
  .clip { position: relative; border-radius: 6px; background-size: cover; background-position: center; opacity: .55; transition: opacity .3s, box-shadow .3s; }
  .clip b { position: absolute; left: 6px; bottom: 4px; font: 700 10px/1 var(--font-body); color: #fff; text-shadow: 0 1px 3px rgba(0, 0, 0, .8); }
  .clip.on { opacity: 1; box-shadow: inset 0 0 0 2px var(--accent-text); }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .playhead { position: absolute; top: -4px; bottom: -4px; left: 0; width: 2px; margin-left: -1px; background: #ff4d6d; border-radius: 2px; box-shadow: 0 0 10px rgba(255, 77, 109, .6); pointer-events: none; }
  .playhead::before { content: ""; position: absolute; top: -3px; left: -4px; width: 10px; height: 10px; border-radius: 3px 3px 50% 50%; background: #ff4d6d; }

  .now { list-style: none; padding: 0; margin: 0; display: grid; }
  .match { grid-area: 1 / 1; display: grid; grid-template-columns: 34px minmax(0, 1fr) auto auto; align-items: center; gap: 12px; padding: 10px 12px; border-radius: 14px;
    background: color-mix(in srgb, var(--accent) 10%, var(--surface)); border: 1px solid color-mix(in srgb, var(--accent) 40%, var(--line)); opacity: 0; transform: translateY(6px); transition: opacity .12s, transform .12s; }
  /* The outgoing track clears before the next fades in, so two titles never overlap. */
  .match.on { opacity: 1; transform: none; transition: opacity .3s .12s, transform .3s .12s; }
  .play { width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; background: var(--accent); }
  .play svg { width: 12px; height: 12px; fill: #fff; }
  .d { min-width: 0; display: grid; line-height: 1.3; }
  .d b { font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .d small { color: var(--muted); font-size: 12px; font-variant-numeric: tabular-nums; }
  .badge { font-size: 12px; font-weight: 700; padding: 4px 10px; border-radius: 999px; background: var(--surface-2); color: var(--muted); white-space: nowrap; }
  .badge.one { color: var(--accent-text); }
  .ring { width: 30px; height: 30px; }
  .ring :global(circle) { fill: none; stroke-width: 3.6; }
  .ring :global(.bg) { stroke: var(--line); }
  .ring :global(.arc) { stroke: var(--accent-text); }
  @media (max-width: 480px) { .badge { display: none; } .match { grid-template-columns: 34px minmax(0, 1fr) auto; } }
</style>

<script>
  // Drives the timeline from the reel's own clock: the playhead follows the video, and each cut moves
  // the active clip, flashes the frame and shows the next matched track. The reel waits
  // for the intro film to finish, plays only while on screen, and stays still for reduced motion.
  const panel = document.querySelector<HTMLElement>("[data-sync]");
  const video = panel?.querySelector<HTMLVideoElement>("[data-reel]");
  const canvas = panel?.querySelector<HTMLCanvasElement>("[data-wave]");
  const ctx = canvas?.getContext("2d");
  if (panel && video && canvas && ctx) {
    const SEG = Number(panel.dataset.seg);
    const clips = [...panel.querySelectorAll<HTMLElement>("[data-clip]")];
    const matches = [...panel.querySelectorAll<HTMLElement>("[data-match]")];
    const cat = panel.querySelector<HTMLElement>("[data-cat]")!;
    const tc = panel.querySelector<HTMLElement>("[data-tc]")!;
    const head = panel.querySelector<HTMLElement>("[data-playhead]")!;
    const N = clips.length, LEN = SEG * N;
    const root = document.documentElement;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)");

    // Waveform: one bar every 4 px, louder towards each cut so the hits read.
    let W = 0, H = 0, dpr = 1, heights: number[] = [];
    const size = () => {
      dpr = Math.min(devicePixelRatio || 1, 2);
      W = canvas.clientWidth; H = canvas.clientHeight;
      canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr);
      const bars = Math.max(1, Math.floor(W / 4));
      heights = Array.from({ length: bars }, (_, i) => {
        const u = i / bars, local = (u * N) % 1;
        const swell = .35 + .65 * Math.pow(local, 1.6);
        const texture = .55 + .45 * Math.abs(Math.sin(i * 1.7) * Math.cos(i * .37));
        return Math.min(1, swell * texture);
      });
    };
    const css = (name: string) => getComputedStyle(panel).getPropertyValue(name).trim();
    const drawWave = (p: number) => {
      const played = css("--accent-text"), ahead = css("--faint");
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, W, H);
      const mid = H / 2, x0 = p * W;
      heights.forEach((h, i) => {
        const x = i * 4 + 1, near = Math.exp(-Math.pow((x - x0) / 14, 2));
        const bh = Math.min(H - 6, Math.max(2, h * (H - 14) * (1 + .3 * near)));
        ctx.fillStyle = x < x0 ? played : ahead;
        ctx.globalAlpha = x < x0 ? 1 : .6;
        ctx.fillRect(x, mid - bh / 2, 2, bh);
      });
      ctx.globalAlpha = 1;
    };

    let seg = -1, raf = 0, cutTimer = 0;
    const pad = (n: number) => String(Math.floor(n)).padStart(2, "0");
    let announced = -1;
    const render = (t: number, live = false) => {
      const p = (t % LEN) / LEN, s = Math.min(N - 1, Math.floor((t % LEN) / SEG));
      head.style.left = `${p * 100}%`;
      tc.textContent = `00:${pad(t % 60)}:${pad((t % 1) * 24)}`;
      if (s !== seg) {
        clips.forEach((c, i) => c.classList.toggle("on", i === s));
        matches.forEach((m, i) => m.classList.toggle("on", i === s));
        cat.textContent = clips[s].textContent;
        if (seg !== -1 && !reduce.matches) {
          panel.classList.remove("cut"); void panel.offsetWidth; panel.classList.add("cut");
          clearTimeout(cutTimer); cutTimer = window.setTimeout(() => panel.classList.remove("cut"), 1100);
        }
        seg = s;
      }
      if (live && s !== announced) {
        announced = s;
        panel.dispatchEvent(new CustomEvent("sync:cut", { bubbles: true, detail: { index: s, label: clips[s].textContent } }));
      }
      drawWave(p);
    };
    const loop = () => { render(video.currentTime, true); raf = requestAnimationFrame(loop); };

    let visible = false, ready = !root.classList.contains("intro");
    const sync = () => {
      cancelAnimationFrame(raf);
      if (ready && visible && !document.hidden && !reduce.matches) {
        video.preload = "auto";
        video.play().then(() => { raf = requestAnimationFrame(loop); }).catch(() => render(SEG * 2.4));
      } else {
        video.pause();
        render(reduce.matches ? SEG * 2.4 : video.currentTime);
      }
    };
    // Start once the intro film has handed over to the page.
    if (!ready) new MutationObserver((_, obs) => {
      if (!root.classList.contains("intro")) { ready = true; obs.disconnect(); sync(); }
    }).observe(root, { attributes: true, attributeFilter: ["class"] });

    video.muted = true;
    size();
    render(reduce.matches ? SEG * 2.4 : 0);
    new ResizeObserver(() => { size(); render(video.currentTime || (reduce.matches ? SEG * 2.4 : 0)); }).observe(canvas);
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; sync(); }).observe(panel);
    document.addEventListener("visibilitychange", sync);
    reduce.addEventListener("change", sync);
  }
</script>
