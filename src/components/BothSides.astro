---
import { audiences } from "../data/site";
const licensees = audiences.filter((a) => a.side === "licensee");
const holders = audiences.filter((a) => a.side === "rights-holder");
---
<section class="section" id="both-sides" aria-labelledby="sides-title">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Built for both sides</p>
      <h2 id="sides-title">One workspace for licensees <span class="hl">and rights holders.</span></h2>
      <p class="lede">Both sides of the deal see the same terms, the same status and the same contract. Nobody chases anybody.</p>
    </div>
    <div class="sides">
      <article class="side plain">
        <span class="tag">For licensees</span>
        <h3>Find music you can <span class="hl">actually use.</span></h3>
        <p>Every result shows who owns it and whether it can be cleared, before you fall in love with it.</p>
        <ul class="chips">{["Production houses", "Sync agencies", "Ad agencies", "Gaming studios", "Film & TV", "Streaming", "Music supervisors"].map((c) => <li>{c}</li>)}</ul>
        <div class="links">{licensees.map((a) => <a href={`/for/${a.slug}/`}>{a.name} <span aria-hidden="true">→</span></a>)}</div>
      </article>
      <article class="side lit">
        <span class="tag">For rights holders</span>
        <h3>Turn your catalog into licensable inventory.</h3>
        <p>Set your terms once. Approve requests, sign licenses and get paid your share without the back and forth.</p>
        <ul class="chips">{["Record labels", "Publishers", "Distributors", "Catalog owners"].map((c) => <li>{c}</li>)}</ul>
        <div class="links">{holders.map((a) => <a href={`/for/${a.slug}/`}>{a.name} <span aria-hidden="true">→</span></a>)}</div>
      </article>
    </div>
  </div>
</section>

<style>
  .sides { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .side { border-radius: var(--radius-lg); padding: clamp(28px, 4vw, 48px); display: grid; gap: 22px; align-content: start; }
  .plain { background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow); }
  .lit { background: var(--band); color: #fff; }
  .tag { justify-self: start; display: inline-flex; align-items: center; min-height: 34px; padding: 0 16px; border-radius: 999px; font-family: var(--font-display); font-weight: 700; font-size: 12px; letter-spacing: .16em; text-transform: uppercase; }
  .plain .tag { border: 1.5px solid var(--accent-text); color: var(--accent-text); }
  .lit .tag { background: #fff; color: #5443d8; }
  .side h3 { font-size: clamp(32px, 3.4vw, 46px); line-height: 1; }
  .lit h3 { color: #fff; }
  .side p { color: var(--muted); max-width: 32em; }
  .lit p { color: rgba(255,255,255,.82); }
  .chips { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .chips li { display: inline-flex; align-items: center; min-height: 36px; padding: 0 14px; border-radius: 999px; font-family: var(--font-display); font-weight: 700; font-size: 12px; letter-spacing: .1em; text-transform: uppercase; }
  .plain .chips li { background: var(--surface-2); }
  .lit .chips li { background: #000; }
  .links { display: flex; flex-wrap: wrap; gap: 8px 20px; padding-top: 18px; border-top: 1px solid var(--line); }
  .lit .links { border-color: rgba(255,255,255,.3); }
  .links a { font-weight: 700; text-decoration: none; }
  .links a:hover { text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 860px) { .sides { grid-template-columns: 1fr; } }
</style>
