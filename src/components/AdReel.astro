---
import { syncMoments } from "../data/site";

const watch = (m: (typeof syncMoments)[number]) =>
  `https://www.youtube.com/results?search_query=${encodeURIComponent(`${m.brand} ${m.ad} ${m.year} ad`)}`;
// A slight, fixed tilt per card so the reel feels pinned up rather than gridded.
const tilt = [-2.2, 1.6, -1.2, 2.4, 1.8, -2, 1.1, -1.6];
---
<section class="reel" aria-labelledby="reel-title" data-play>
  <div class="wrap inner">
    <header class="head">
      <p class="eyebrow">Legendary sync moments</p>
      <h2 id="reel-title">Sometimes the song <span class="hl">is the ad.</span></h2>
    </header>

    <ol class="cards">
      {syncMoments.map((m, i) => (
        <li class="card" style={`--i:${i};--r:${tilt[i % tilt.length]}deg`}>
          <div class="screen">
            <p class="brand"><span>{m.brand}</span> <span class="ad">{m.ad}</span></p>
            <span class="year">{m.year}</span>
            <h3 class="song">{m.song}<span class="artist">{m.artist}</span></h3>
            <span class="eq" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
          </div>
          <div class="meta">
            <p class="after">{m.after}</p>
            <a class="watch" href={watch(m)} target="_blank" rel="noopener" aria-label={`Watch the ${m.brand} ${m.ad} ad on YouTube (opens in a new tab)`}>Watch on YouTube <span aria-hidden="true">↗</span></a>
          </div>
        </li>
      ))}
    </ol>

    <footer class="foot" style={`--i:${syncMoments.length}`}>
      <p class="line">Each one started with someone finding the right track.</p>
      <a class="next" href="#hero">Find yours <span aria-hidden="true">↓</span></a>
      <small>Brand, ad and song names belong to their owners. Synkro had no part in these campaigns.</small>
    </footer>
  </div>
</section>

<style>
  .reel { padding-block: clamp(40px, 6vh, 72px) clamp(48px, 7vh, 88px); min-height: calc(100svh - 72px); display: flex; align-items: center; overflow: hidden; }
  .inner { width: 100%; display: grid; gap: clamp(24px, 4vh, 40px); }
  .head { display: grid; gap: 12px; }
  .head h2 { font-size: clamp(40px, 5.4vw, 84px); line-height: .92; }

  .cards { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(16px, 2vw, 28px); }
  .card { display: grid; gap: 12px; align-content: start; }
  .screen { transform: rotate(var(--r)); }
  .screen { position: relative; aspect-ratio: 16 / 10; border-radius: 14px; overflow: hidden; padding: 12px 14px; display: grid; grid-template-rows: auto 1fr auto; color: #fff;
    background: radial-gradient(120% 90% at 20% 0%, rgba(125, 110, 247, .55), transparent 60%), radial-gradient(90% 80% at 100% 100%, rgba(84, 67, 216, .45), transparent 65%), #0b0b10;
    box-shadow: 0 18px 40px -18px rgba(20, 10, 80, .55), inset 0 0 0 1px rgba(255, 255, 255, .08); }
  .card:nth-child(even) .screen { background: radial-gradient(110% 90% at 85% 0%, rgba(125, 110, 247, .5), transparent 60%), radial-gradient(90% 80% at 0% 100%, rgba(84, 67, 216, .4), transparent 65%), #0b0b10; }
  .brand { grid-row: 1; font: 700 12px/1.3 var(--font-body); letter-spacing: .14em; text-transform: uppercase; padding-right: 44px; }
  .brand .ad { display: block; letter-spacing: .04em; text-transform: none; font-weight: 600; opacity: .7; }
  .year { position: absolute; top: 12px; right: 14px; font: 700 12px/1 var(--font-body); font-variant-numeric: tabular-nums; opacity: .8; }
  .song { grid-row: 2; align-self: center; font-size: clamp(18px, 1.7vw, 26px); line-height: 1.02; color: #fff; }
  .artist { display: block; margin-top: 6px; font: 600 13px/1.2 var(--font-body); letter-spacing: 0; color: rgba(255, 255, 255, .72); }
  .eq { grid-row: 3; display: flex; align-items: flex-end; gap: 3px; height: 16px; }
  .eq i { width: 3px; height: 100%; border-radius: 2px; background: #fff; opacity: .85; transform-origin: bottom; transform: scaleY(.35); }

  .meta { display: grid; gap: 2px; padding-inline: 4px; }
  .after { font-size: 14px; line-height: 1.45; color: var(--muted); }
  .watch { justify-self: start; margin-top: 2px; font-size: 13px; font-weight: 700; min-height: 32px; display: inline-flex; align-items: center; text-underline-offset: 4px; }

  .foot { display: grid; justify-items: start; gap: 8px; }
  .line { font-size: clamp(18px, 1.6vw, 22px); font-weight: 600; }
  .next { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; font-weight: 700; font-size: 17px; color: var(--accent-text); text-underline-offset: 5px; }
  .foot small { color: var(--faint); font-size: 12px; }

  /* Cards pop up one after another, then the closing line. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .reel:not(:global(.play)) .card,
    :global(.js) .reel:not(:global(.play)) .foot { opacity: 0; }
    :global(.js) .reel:global(.play) .card { animation: card-in .7s cubic-bezier(.2, 1.4, .4, 1) both; animation-delay: calc(var(--i) * 180ms + 150ms); }
    :global(.js) .reel:global(.play) .foot { animation: foot-in .6s ease-out both; animation-delay: calc(var(--i) * 180ms + 350ms); }
    .eq i { animation: eq 1s ease-in-out infinite alternate; }
    .eq i:nth-child(2) { animation-duration: .7s; animation-delay: -.2s; }
    .eq i:nth-child(3) { animation-duration: 1.2s; animation-delay: -.5s; }
    .eq i:nth-child(4) { animation-duration: .8s; animation-delay: -.1s; }
    .eq i:nth-child(5) { animation-duration: 1.05s; animation-delay: -.7s; }
  }
  @keyframes card-in { from { opacity: 0; transform: translateY(40px) scale(.82) rotate(calc(var(--r) * -2)); } to { opacity: 1; transform: none; } }
  @keyframes foot-in { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  @keyframes eq { to { transform: scaleY(1); } }

  @media (max-width: 1023px) { .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  /* Phones: one swipeable row, so the reel doesn't push the hero far down. */
  @media (max-width: 639px) {
    .reel { min-height: 0; }
    .cards { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; margin-inline: calc(-1 * var(--gutter)); padding: 8px var(--gutter) 16px; scrollbar-width: none; }
    .cards::-webkit-scrollbar { display: none; }
    .card { flex: 0 0 78%; scroll-snap-align: start; }
  }
</style>
