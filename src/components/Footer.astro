---
import { audiences, site } from "../data/site";
const year = new Date().getFullYear();
---
<footer class="footer ink">
  <div class="wrap">
    <div class="top">
      <div class="lockup">
        <a class="brand" href="/">{site.name}</a>
        <p>{site.tagline}</p>
      </div>
      <nav aria-label="Footer" class="cols">
        <div>
          <h2 class="eyebrow">Product</h2>
          <ul>
            <li><a href="/how-it-works/">How it works</a></li>
            <li><a href="/#waitlist">Join the waitlist</a></li>
          </ul>
        </div>
        <div>
          <h2 class="eyebrow">Built for</h2>
          <ul>{audiences.map((a) => <li><a href={`/for/${a.slug}/`}>{a.name}</a></li>)}</ul>
        </div>
        <div>
          <h2 class="eyebrow">Learn</h2>
          <ul>
            <li><a href="/sync-licensing/">Sync licensing guide</a></li>
            <li><a href="/glossary/">Licensing glossary</a></li>
            <li><a href="/about/">About</a></li>
          </ul>
        </div>
      </nav>
    </div>
    <div class="base">
      <span>© {year} {site.name}</span>
      <span class="chev" aria-hidden="true">{[0, 1, 2, 3].map(() => <svg viewBox="0 0 26 32"><path d="M2 2l14 14L2 30h8l14-14L10 2z" /></svg>)}</span>
    </div>
  </div>
</footer>

<style>
  .footer { padding-block: 72px 32px; }
  .top { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr); gap: 48px; padding-bottom: 56px; border-bottom: 1px solid var(--line); }
  .brand { font-family: var(--font-display); font-weight: 900; font-size: clamp(56px, 8vw, 104px); letter-spacing: -.07em; line-height: .9; text-decoration: none; }
  .lockup p { color: var(--muted); margin-top: 16px; }
  .cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .cols h2 { font-size: 11px; letter-spacing: .2em; margin-bottom: 16px; line-height: 1.2; }
  .cols ul { list-style: none; padding: 0; display: grid; gap: 10px; }
  .cols a { text-decoration: none; color: #d6d6de; font-size: 15px; }
  .cols a:hover { color: #fff; }
  .base { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding-top: 24px; color: var(--muted); font-size: 14px; }
  .chev { display: inline-flex; color: #7d6ef7; }
  .chev svg { width: 22px; height: 28px; margin-right: -10px; fill: currentColor; }
  @media (max-width: 860px) { .top { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .cols { grid-template-columns: 1fr 1fr; } }
</style>
