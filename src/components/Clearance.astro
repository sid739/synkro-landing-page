---
import Waveform from "./Waveform.astro";
import TrackLabel from "./TrackLabel.astro";
import "../styles/cards.css";
const file = `<svg viewBox="0 0 24 24"><path d="M6 3h8l4 4v14H6z M14 3v4h4"/></svg>`;
const holders = ["Master approval (Believe)", "Publisher 1 (Sony Publishing)", "Publisher 2 (Universal Publishing)"];
const diffs = [["Territory", "North America", "Worldwide"], ["Media scope", "Web only", "All media & social"], ["Term length", "1 year", "3 years + options"]];
---
<section class="section ink" id="clearance" aria-labelledby="clearance-title">
  <div class="wrap">
    <div class="part-head" data-reveal>
      <TrackLabel n={3} label="Clearance" />
      <h2 id="clearance-title" class="poster">The Clearance <span class="hl">Workspace</span></h2>
      <p class="lede">Bring every rights holder into one deal room to agree splits, redline and sign.</p>
      <Waveform seed={4} />
    </div>

    <div class="cards-grid">
      <article class="fcard wide" data-reveal data-play>
        <div class="text">
          <h3>All holders on one <span class="hl">thread</span></h3>
          <p>Negotiate splits, counters and MFN terms in a single thread.</p>
        </div>
        <div class="ui">
          {holders.map((h, i) => (
            <div class="holder">
              <div><span>{h}</span><b class="a" style={`--i: ${i}; --d: 1100ms`}>100% Agreed</b></div>
              <span class="fill" style={`--i: ${i}`}><i style="--to: 100%"></i></span>
            </div>
          ))}
        </div>
      </article>

      <article class="fcard" data-reveal data-play style="--rd: 120ms">
        <div class="text">
          <h3>Secure digital <span class="hl">signatures</span></h3>
          <p>Every party signs in one place, with each signature tracked.</p>
        </div>
        <div class="ui">
          {["Licensee signed", "Publisher signed", "Master owner signed"].map((s, i) => (
            <div class="sig"><span class="tick" style={`--i: ${i}; --d: 200ms`}>✓</span>{s}</div>
          ))}
        </div>
      </article>

      <article class="fcard" data-reveal data-play>
        <div class="text">
          <h3>Synkro Contract <span class="hl">Assistant</span></h3>
          <p>Checks each draft against the agreed terms and flags any mismatch.</p>
        </div>
        <div class="ui">
          {diffs.map(([k, from, to], i) => (
            <div class="diff">
              <small>{k}</small>
              <span><s>{from}</s> <ins class="a" style={`--i: ${i}; --d: 400ms`}>→ {to}</ins></span>
            </div>
          ))}
        </div>
      </article>


      <article class="fcard" data-reveal data-play style="--rd: 120ms">
        <div class="text">
          <h3>Simplified global <span class="hl">payments</span></h3>
          <p>The licensee pays once. We split it across every holder and handle the tax.</p>
        </div>
        <div class="ui">
          <div class="row"><span>One payment in</span><span class="money" data-count="42000" data-prefix="€">€42,000</span></div>
          <div class="row a" style="--i: 0; --d: 900ms"><span>↳ Master side · 100%</span><span>€12,000 paid</span></div>
          <div class="row a" style="--i: 1; --d: 900ms"><span>↳ Publishing side · 50 / 50</span><span>€30,000 paid</span></div>
          <div class="row a" style="--i: 2; --d: 900ms"><span>Taxes withheld &amp; remitted</span><span>€6,750</span></div>
        </div>
      </article>

      <article class="fcard" data-reveal data-play style="--rd: 240ms">
        <div class="text">
          <h3>Clearance pack <span class="hl">delivery</span></h3>
          <p>Broadcast-ready WAVs, stems and the signed license in one download.</p>
        </div>
        <div class="ui">
          {["Master.wav", "Stems.zip", "License.pdf"].map((f, i) => (
            <div class="file a" style={`--i: ${i}`}><span class="ficon" set:html={file} /><span>{f}</span><em>Download</em></div>
          ))}
        </div>
      </article>
    </div>
  </div>
</section>

<script>
  import "../scripts/cards";
</script>
