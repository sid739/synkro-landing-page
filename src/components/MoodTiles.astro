---
import { moods } from "../data/moods";
---
<section class="section" id="moods" aria-labelledby="moods-title">
  <div class="wrap">
    <div class="head" data-reveal>
      <p class="eyebrow">Browse by mood</p>
      <h2 id="moods-title">Every mood, <span class="hl">on cue</span></h2>
      <p class="lede">Not sure what you need yet? Start from a feeling and narrow it down.</p>
    </div>
    <ul class="tiles">
      {moods.map((m, i) => (
        <li class="tile" data-reveal style={`--rd: ${i * 70}ms`} data-tile>
          <video muted loop playsinline preload="none" poster={`/moods/${m.slug}.jpg`} aria-hidden="true">
            <source src={`/moods/${m.slug}.mp4`} type="video/mp4" />
            <source src={`/moods/${m.slug}.webm`} type="video/webm" />
          </video>
          <div class="label">
            <h3>{m.name}</h3>
            <p>{m.sound}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .head { display: grid; justify-items: center; text-align: center; gap: 16px; max-width: 760px; margin: 0 auto clamp(36px, 5vw, 56px); }
  .tiles { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .tile { position: relative; aspect-ratio: 4 / 5; border-radius: var(--radius-lg); overflow: hidden; background: #050508; isolation: isolate; }
  video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .7s cubic-bezier(.2, .7, .2, 1); }
  .tile::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to top, rgba(5, 5, 8, .8) 0%, rgba(5, 5, 8, .15) 45%, transparent 70%); pointer-events: none; }
  .label { position: absolute; z-index: 1; left: 0; right: 0; bottom: 0; padding: clamp(18px, 2vw, 26px); color: #fff; display: grid; gap: 4px; }
  .label h3 { font-size: clamp(30px, 3.2vw, 46px); font-stretch: 70%; font-weight: 850; text-transform: uppercase; letter-spacing: -.01em; line-height: .95; }
  .label p { font-size: 15px; color: rgba(255, 255, 255, .78); }
  .tile.playing video { transform: scale(1.04); }
  @media (max-width: 960px) { .tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) {
    .tiles { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; margin-inline: calc(-1 * var(--gutter)); padding-inline: var(--gutter); scrollbar-width: none; }
    .tiles::-webkit-scrollbar { display: none; }
    .tile { flex: 0 0 72%; scroll-snap-align: start; }
  }
</style>

<script>
  // A tile's still turns into slow-motion footage: on hover where there is a pointer, and while it is
  // mostly on screen on touch devices. Nothing plays for visitors who ask for reduced motion.
  const reduce = matchMedia("(prefers-reduced-motion: reduce)");
  const hover = matchMedia("(hover: hover)");
  const tiles = [...document.querySelectorAll<HTMLElement>("[data-tile]")];
  const play = (tile: HTMLElement, on: boolean) => {
    const video = tile.querySelector("video");
    if (!video) return;
    if (on && !reduce.matches) {
      video.preload = "auto";
      video.play().then(() => tile.classList.add("playing")).catch(() => {});
    } else { video.pause(); tile.classList.remove("playing"); }
  };
  const seen = new IntersectionObserver((entries) => {
    for (const e of entries) if (!hover.matches) play(e.target as HTMLElement, e.intersectionRatio >= 0.6);
  }, { threshold: [0, 0.6] });
  for (const tile of tiles) {
    tile.querySelector("video")!.muted = true;
    tile.addEventListener("pointerenter", (e) => { if (e.pointerType === "mouse") play(tile, true); });
    tile.addEventListener("pointerleave", (e) => { if (e.pointerType === "mouse") play(tile, false); });
    seen.observe(tile);
  }
</script>
