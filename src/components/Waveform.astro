---
// A short audio waveform used as a rule under section titles. A bright copy sweeps across it from the
// left the first time it scrolls into view, like a track playing. The bar heights come from the seed, so
// each section's waveform has its own shape and every build draws the same one.
interface Props { seed?: number; bars?: number }
const { seed = 1, bars = 72 } = Astro.props;
let s = seed * 9973 + 17;
const rand = () => ((s = (s * 16807) % 2147483647) / 2147483647);
const W = 3, GAP = 2, H = 28;
const heights = Array.from({ length: bars }, (_, i) => {
  const env = Math.sin((Math.PI * (i + .5)) / bars);               // quiet at both ends
  return Math.max(2, Math.round(H * env * (.35 + .65 * rand())));
});
const width = bars * (W + GAP) - GAP;
const rects = heights.map((h, i) => `<rect x="${i * (W + GAP)}" y="${(H - h) / 2}" width="${W}" height="${h}" rx="1.5"/>`).join("");
---
<div class="wave" aria-hidden="true" data-wave>
  <svg class="base" viewBox={`0 0 ${width} ${H}`} set:html={rects} />
  <svg class="lit" viewBox={`0 0 ${width} ${H}`} set:html={rects} />
</div>

<style>
  .wave { position: relative; width: min(360px, 70%); aspect-ratio: auto; height: 28px; margin-inline: auto; }
  svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .base { fill: currentColor; opacity: .18; }
  .lit { fill: var(--accent-text); clip-path: inset(0 0 0 0); }
  :global(.band) .lit { fill: var(--on-band); }
  :global(.section-head) .wave { margin-inline: 0; }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .lit { clip-path: inset(0 100% 0 0); }
    .wave.play .lit { animation: sweep 1.8s cubic-bezier(.4, 0, .2, 1) forwards; }
    @keyframes sweep { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
  }
</style>

<script>
  // Plays the sweep once, when a waveform first comes into view.
  const waves = document.querySelectorAll<HTMLElement>("[data-wave]");
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      const el = e.target as HTMLElement;
      if (e.isIntersecting) { el.classList.add("play"); io.unobserve(el); }
    }
  }, { threshold: 1 });
  waves.forEach((w) => io.observe(w));
</script>
