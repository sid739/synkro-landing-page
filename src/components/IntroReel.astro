---
import { syncMoments } from "../data/site";

// Scene words rise in one after another, so each word is its own span.
const words = (text: string, from = 0) => text.split(" ").map((w, i) => ({ w, i: from + i }));

// Where the violet light sits in each scene: title, eight ads, closing line.
const glow = [[50, 40], [20, 30], [80, 25], [30, 70], [75, 65], [15, 55], [85, 45], [40, 20], [65, 75], [50, 55]];

// A row of sound bars along the bottom, with fixed heights and speeds so every build matches.
const bars = Array.from({ length: 64 }, (_, i) => ({
  h: 0.25 + 0.75 * Math.abs(Math.sin(i * 0.61) * Math.cos(i * 0.23)),
  s: 0.7 + ((i * 37) % 9) / 10,
}));
const sceneCount = syncMoments.length + 2;
---
<section class="reel" aria-labelledby="reel-title" data-reel data-glow={JSON.stringify(glow)}>
  <div class="wrap inner">
    <div class="scenes">
      <div class="scene title on" data-scene>
        <p class="eyebrow">Legendary sync moments</p>
        <h2 id="reel-title" class="big">
          {words("Sometimes the song").map(({ w, i }) => <><span class="w"><span style={`--w:${i}`}>{w}</span></span> </>)}
          <span class="hl">{words("is the ad.", 3).map(({ w, i }) => <><span class="w"><span style={`--w:${i}`}>{w}</span></span> </>)}</span>
        </h2>
      </div>

      {syncMoments.map((m) => (
        <article class="scene ad" data-scene>
          <span class="year" aria-hidden="true">{m.year}</span>
          <p class="spot">{m.brand} · {m.ad} · {m.year}</p>
          <h3 class="big">{words(m.song).map(({ w, i }) => <><span class="w"><span style={`--w:${i}`}>{w}</span></span> </>)}</h3>
          <p class="artist">{m.artist}</p>
          <p class="after">{m.after}</p>
        </article>
      ))}

      <div class="scene end" data-scene>
        <p class="big">{words("Each one started with someone finding the right track.").map(({ w, i }) => <><span class="w"><span style={`--w:${i}`}>{w}</span></span> </>)}</p>
        <a class="next" href="#hero">Find yours <span aria-hidden="true">↓</span></a>
      </div>
    </div>

    <div class="controls">
      <ol class="steps" aria-label="Scenes">
        {Array.from({ length: sceneCount }, (_, i) => {
          const label = i === 0 ? "Title" : i === sceneCount - 1 ? "Closing" : `${syncMoments[i - 1].brand} ${syncMoments[i - 1].ad}`;
          return <li><button type="button" data-dot aria-label={`Show scene: ${label}`}><i></i></button></li>;
        })}
      </ol>
      <a class="skip-intro" href="#hero">Skip intro <span aria-hidden="true">↓</span></a>
    </div>
    <small class="note">Brand, ad and song names belong to their owners. Synkro had no part in these campaigns.</small>
  </div>

  <div class="bars" aria-hidden="true">
    {bars.map((b) => <i style={`--h:${b.h.toFixed(2)};--s:${b.s.toFixed(2)}s`}></i>)}
  </div>
</section>

<style>
  .reel { --gx: 50%; --gy: 40%; position: relative; overflow: hidden; isolation: isolate; }
  .reel::before { content: ""; position: absolute; inset: -10%; z-index: -1; pointer-events: none;
    background: radial-gradient(40% 50% at var(--gx) var(--gy), color-mix(in srgb, var(--accent) 28%, transparent), transparent 70%);
    }
  .reel { transition: --gx 1.4s ease, --gy 1.4s ease; }
  @property --gx { syntax: "<percentage>"; inherits: true; initial-value: 50%; }
  @property --gy { syntax: "<percentage>"; inherits: true; initial-value: 40%; }
  .inner { position: relative; display: grid; gap: 20px; padding-block: 48px 96px; }

  .eyebrow { margin-bottom: 18px; }
  .big { font-family: var(--font-display); font-weight: 850; letter-spacing: -.055em; line-height: .95; text-wrap: balance; }
  .title .big { font-size: clamp(48px, 8vw, 132px); }
  .ad .big { font-size: clamp(44px, 7.4vw, 120px); max-width: 12em; }
  .end .big { font-size: clamp(36px, 5.6vw, 88px); max-width: 14em; }
  .w { display: inline-block; }

  .scene { position: relative; display: grid; justify-items: start; align-content: center; }
  .spot { font: 700 13px/1.3 var(--font-body); letter-spacing: .16em; text-transform: uppercase; color: var(--accent-text); margin-bottom: 18px; }
  .artist { margin-top: 18px; font-size: clamp(20px, 2vw, 28px); font-weight: 700; }
  .artist::before { content: "— "; color: var(--muted); }
  .after { margin-top: 10px; font-size: clamp(16px, 1.3vw, 19px); color: var(--muted); max-width: 34em; }
  .year { position: absolute; z-index: -1; right: 0; top: 50%; transform: translateY(-50%); font: 850 clamp(140px, 24vw, 360px)/1 var(--font-display); letter-spacing: -.06em;
    color: transparent; -webkit-text-stroke: 1.5px color-mix(in srgb, var(--accent-text) 45%, transparent); pointer-events: none; }
  .next { margin-top: 28px; display: inline-flex; align-items: center; gap: 10px; min-height: 56px; padding: 0 26px; border-radius: 999px; background: var(--accent); color: #fff; font: 700 17px var(--font-body); text-decoration: none; }
  .next:hover { background: #6152e6; }

  .controls { display: none; }
  .note { color: var(--faint); font-size: 12px; }
  .bars { display: none; }

  /* Without JavaScript, or with reduced motion: every scene listed, nothing moves. */
  .scenes { display: grid; gap: 40px; }
  .ad .big { font-size: clamp(32px, 4vw, 56px); }
  .year { display: none; }

  /* The reel: scenes stack in one place and play one after another. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .reel { min-height: calc(100svh - 72px); display: flex; align-items: center; }
    :global(.js) .inner { width: 100%; }
    :global(.js) .scenes { gap: 0; min-height: clamp(360px, 52vh, 560px); }
    :global(.js) .scene { grid-area: 1 / 1; visibility: hidden; }
    :global(.js) .ad .big { font-size: clamp(44px, 7.4vw, 120px); }
    :global(.js) .year { display: block; }
    :global(.js) .scene.on, :global(.js) .scene.was { visibility: visible; }

    :global(.js) .scene .w { overflow: hidden; vertical-align: top; padding-bottom: .08em; margin-bottom: -.08em; }
    :global(.js) .scene .w > span { display: inline-block; transform: translateY(110%); }
    :global(.js) .scene.on .w > span { animation: word .8s cubic-bezier(.2, .8, .2, 1) both; animation-delay: calc(var(--w) * 80ms + 150ms); }
    :global(.js) .scene.on :is(.eyebrow, .spot) { animation: fade .6s ease-out both; }
    :global(.js) .scene.on :is(.artist, .next) { animation: fade .6s ease-out both; animation-delay: .7s; }
    :global(.js) .scene.on .after { animation: fade .6s ease-out both; animation-delay: 1s; }
    :global(.js) .scene.on .year { animation: drift var(--dur, 3.4s) linear both; }
    :global(.js) .scene.was { animation: out .5s ease-in both; }

    :global(.js) .controls { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-top: 12px; }
    .steps { list-style: none; padding: 0; display: flex; gap: 6px; flex: 1; max-width: 520px; }
    .steps li { flex: 1; }
    .steps button { width: 100%; height: 24px; padding: 0; border: 0; background: none; cursor: pointer; display: flex; align-items: center; }
    .steps i { position: relative; display: block; width: 100%; height: 3px; border-radius: 2px; background: var(--line); overflow: hidden; }
    .steps i::after { content: ""; position: absolute; inset: 0; background: var(--accent-text); transform: scaleX(0); transform-origin: left; }
    .steps button.done i::after { transform: none; }
    .steps button.run i::after { animation: fill var(--dur, 3.4s) linear both; }
    .reel.paused .steps button.run i::after { animation-play-state: paused; }
    .steps button:focus-visible { outline: 2px solid var(--accent-text); outline-offset: 2px; border-radius: 4px; }
    .skip-intro { font-size: 14px; font-weight: 700; color: var(--muted); min-height: 44px; display: inline-flex; align-items: center; gap: 6px; text-underline-offset: 4px; }

    :global(.js) .bars { position: absolute; left: 0; right: 0; bottom: 0; height: 64px; display: flex; align-items: flex-end; gap: 3px; padding-inline: 8px; opacity: .5; z-index: -1; }
    .bars i { flex: 1; height: calc(var(--h) * 100%); border-radius: 2px 2px 0 0; background: linear-gradient(to top, color-mix(in srgb, var(--accent-text) 60%, transparent), transparent);
      transform-origin: bottom; animation: bar var(--s) ease-in-out infinite alternate; }
    .reel.paused .bars i { animation-play-state: paused; }
  }

  @keyframes word { to { transform: none; } }
  @keyframes fade { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  @keyframes drift { from { opacity: 0; transform: translate(8%, -50%); } 15% { opacity: 1; } to { opacity: 1; transform: translate(0, -50%); } }
  @keyframes out { to { opacity: 0; transform: translateY(-28px); filter: blur(6px); } }
  @keyframes fill { to { transform: none; } }
  @keyframes bar { from { transform: scaleY(.3); } to { transform: scaleY(1); } }

  @media (max-width: 639px) {
    .year { display: none !important; }
    .steps { gap: 4px; }
  }
</style>

<script>
  // Plays the scenes in turn. Pauses while the reel is off screen, the tab is hidden, or the
  // pointer or keyboard focus is on the reel, and lets the scene bar jump to any scene.
  const reel = document.querySelector<HTMLElement>("[data-reel]");
  const reduce = matchMedia("(prefers-reduced-motion: reduce)");
  if (reel && !reduce.matches) {
    const scenes = [...reel.querySelectorAll<HTMLElement>("[data-scene]")];
    const dots = [...reel.querySelectorAll<HTMLButtonElement>("[data-dot]")];
    const glow: [number, number][] = JSON.parse(reel.dataset.glow ?? "[]");
    const last = scenes.length - 1;
    const length = (k: number) => (k === 0 ? 2800 : k === last ? 5600 : 3600);

    let current = 0, left = 0, started = 0, timer = 0, running = false;
    let hovered = false, focused = false, visible = true;

    const show = (k: number) => {
      scenes.forEach((s, j) => {
        s.classList.toggle("was", j === current && j !== k);
        s.classList.toggle("on", j === k);
        s.inert = j !== k;
      });
      dots.forEach((d, j) => {
        d.classList.remove("run");
        d.classList.toggle("done", j < k);
        if (j === k) d.setAttribute("aria-current", "step"); else d.removeAttribute("aria-current");
      });
      void dots[k]?.offsetWidth;                         // restart the progress fill
      dots[k]?.classList.add("run");
      const [x, y] = glow[k % glow.length] ?? [50, 40];
      reel.style.setProperty("--gx", `${x}%`);
      reel.style.setProperty("--gy", `${y}%`);
      reel.style.setProperty("--dur", `${length(k)}ms`);
      current = k;
      left = length(k);
      if (running) { clearTimeout(timer); started = performance.now(); timer = window.setTimeout(advance, left); }
    };
    const advance = () => show(current === last ? 0 : current + 1);

    const update = () => {
      const go = visible && !hovered && !focused && !document.hidden;
      if (go === running) return;
      running = go;
      reel.classList.toggle("paused", !go);
      if (go) { started = performance.now(); timer = window.setTimeout(advance, left); }
      else { clearTimeout(timer); left = Math.max(0, left - (performance.now() - started)); }
    };

    dots.forEach((d, j) => d.addEventListener("click", () => show(j)));
    reel.addEventListener("pointerenter", (e) => { if (e.pointerType === "mouse") { hovered = true; update(); } });
    reel.addEventListener("pointerleave", () => { hovered = false; update(); });
    // Keyboard focus pauses; a mouse click on the scene bar does not.
    const keyFocus = () => { focused = !!reel.querySelector(":focus-visible"); update(); };
    reel.addEventListener("focusin", keyFocus);
    reel.addEventListener("focusout", () => requestAnimationFrame(keyFocus));
    document.addEventListener("visibilitychange", update);
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; update(); }, { threshold: 0.3 }).observe(reel);

    show(0);
    update();
  }
</script>
