---
import Waveform from "./Waveform.astro";
import TrackLabel from "./TrackLabel.astro";
import "../styles/cards.css";
const file = `<svg viewBox="0 0 24 24"><path d="M6 3h8l4 4v14H6z M14 3v4h4"/></svg>`;
const holders = ["Master approval (Believe)", "Publisher 1 (Sony Publishing)", "Publisher 2 (Universal Publishing)"];
const diffs = [["Territory", "North America", "Worldwide"], ["Media scope", "Web only", "All media & social"], ["Term length", "1 year", "3 years + options"]];
const tabs = [{ id: "find", n: "01", label: "Find the music" }, { id: "clear", n: "02", label: "Clear it and get paid" }] as const;
---
<section class="section" id="product" aria-labelledby="product-title">
  <div class="wrap">
    <div class="part-head" data-reveal>
      <TrackLabel n={3} label="The product" />
      <h2 id="product-title" class="poster">Find it. <span class="hl">Clear it.</span> Get paid</h2>
      <p class="lede">Bring in your catalog, search it by brief, then bring every rights holder into one deal room to agree, sign and pay.</p>
      <Waveform seed={3} />
    </div>

    <div class="tabs" role="tablist" aria-label="Product" data-reveal data-product-tabs>
      {tabs.map((t, i) => (
        <button type="button" role="tab" id={`product-tab-${t.id}`} aria-controls={`product-${t.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>
          <span class="n">{t.n}</span>{t.label}
        </button>
      ))}
    </div>

    <div class="cards-grid" role="tabpanel" id="product-find" aria-labelledby="product-tab-find">
      <article class="fcard wide" data-reveal data-play>
        <div class="text">
          <h3>Instant catalog ingestion &amp; <span class="hl">AI enrichment</span></h3>
          <p>Import by CSV, DDEX, Drive or upload. Synkro tags 20+ musical attributes and finds every master and publishing split.</p>
        </div>
        <div class="ui">
          <span class="cap">Import sources</span>
          <div class="chips">{["CSV", "DDEX Feed", "Drive", "Manual"].map((c, i) => <span class="chip light" style={`--i: ${i}`}>{c}</span>)}</div>
          <span class="cap">20+ acoustic &amp; AI parameters</span>
          <div class="chips">{["G-Major · 124 BPM", "Rising arc", "Chord: I-V-vi-IV", "Nostalgic synth"].map((c, i) => <span class="chip a" style={`--i: ${i}; --d: 900ms`}>{c}</span>)}</div>
          <div class="holder a" style="--i: 0; --d: 1500ms">
            <div><span class="cap">Finding splits</span><b>Live lookup</b></div>
            <span class="fill" style="--i: 0; --d: 1600ms"><i style="--to: 100%"></i></span>
            <div><span>Believe (50%)</span><span>Sony (25%) / Warner (25%)</span></div>
          </div>
          <div class="done a" style="--i: 0; --d: 3000ms"><span class="tick" style="--d: 3100ms">✓</span>Splits &amp; parameters extracted</div>
        </div>
      </article>

      <article class="fcard" data-reveal data-play style="--rd: 120ms">
        <div class="text">
          <h3>Direct rights <span class="hl">lookups</span></h3>
          <p>See the splits for any song and send a license request.</p>
        </div>
        <div class="ui">
          <div class="field"><small>Song name</small><b data-type>Starboy</b></div>
          <div class="field"><small>Artist name</small><b data-type data-delay="500">The Weeknd</b></div>
          <div class="field"><small>Territory</small><b data-type data-delay="1100">Worldwide</b></div>
          <span class="btnlike a" style="--d: 1700ms">Surface splits &amp; request</span>
        </div>
      </article>


      <article class="fcard" data-reveal data-play style="--rd: 120ms">
        <div class="text">
          <h3>Custom terms <span class="hl">license requests</span></h3>
          <p>Package media, territory, term and options into one request.</p>
        </div>
        <div class="ui">
          <div class="row a" style="--i: 0"><span>Media scope</span><span>Paid &amp; unpaid social</span></div>
          <div class="row a" style="--i: 1"><span>Territory</span><span>Worldwide</span></div>
          <div class="row a" style="--i: 2"><span>Options</span><span>+1 year option (10% lift)</span></div>
          <span class="chip on a" style="--i: 3">+ 5 more terms</span>
        </div>
      </article>

      <article class="fcard wide" data-reveal data-play>
        <div class="text">
          <h3>Search as a <span class="hl">workspace</span></h3>
          <p>Drop in briefs, reference tracks and video, then refine the results in conversation.</p>
        </div>
        <div class="ui">
          <div class="row"><span class="cap">Creative brief</span><span class="chip on lock"><svg viewBox="0 0 16 16" aria-hidden="true"><rect x="3" y="7" width="10" height="7" rx="1.5"/><path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2"/></svg>NDA secure</span></div>
          <div class="field"><small>Brief</small><b data-type>TV Spot: Upbeat electronic for luxury watch...</b></div>
          <div class="split">
            <div class="file a" style="--i: 0; --d: 1400ms"><span class="ficon" set:html={file} /><span>Audio_Ref.wav</span></div>
            <div class="file a" style="--i: 1; --d: 1400ms"><span class="ficon" set:html={file} /><span>Scene_Cut.mp4</span></div>
          </div>
          <p class="bubble me a" style="--d: 2000ms">Make it more energetic during the climax scene at 0:24</p>
          <p class="bubble ai a" style="--d: 2600ms">Adjusted energy curve to match the climax drop at 0:24. Filtered 3 matching electronic tracks.</p>
        </div>
      </article>
    </div>

    <div class="cards-grid" role="tabpanel" id="product-clear" aria-labelledby="product-tab-clear" hidden>
      <article class="fcard wide" data-reveal data-play>
        <div class="text">
          <h3>All holders on one <span class="hl">thread</span></h3>
          <p>Negotiate splits, counters and MFN terms in a single thread.</p>
        </div>
        <div class="ui">
          {holders.map((h, i) => (
            <div class="holder">
              <div><span>{h}</span><b class="a" style={`--i: ${i}; --d: 1100ms`}>100% Agreed</b></div>
              <span class="fill" style={`--i: ${i}`}><i style="--to: 100%"></i></span>
            </div>
          ))}
        </div>
      </article>

      <article class="fcard" data-reveal data-play style="--rd: 120ms">
        <div class="text">
          <h3>Secure digital <span class="hl">signatures</span></h3>
          <p>Every party signs in one place, with each signature tracked.</p>
        </div>
        <div class="ui">
          {["Licensee signed", "Publisher signed", "Master owner signed"].map((s, i) => (
            <div class="sig"><span class="tick" style={`--i: ${i}; --d: 200ms`}>✓</span>{s}</div>
          ))}
        </div>
      </article>

      <article class="fcard" data-reveal data-play>
        <div class="text">
          <h3>Synkro Contract <span class="hl">Assistant</span></h3>
          <p>Checks each draft against the agreed terms and flags any mismatch.</p>
        </div>
        <div class="ui">
          {diffs.map(([k, from, to], i) => (
            <div class="diff">
              <small>{k}</small>
              <span><s>{from}</s> <ins class="a" style={`--i: ${i}; --d: 400ms`}>→ {to}</ins></span>
            </div>
          ))}
        </div>
      </article>


      <article class="fcard" data-reveal data-play style="--rd: 120ms">
        <div class="text">
          <h3>Simplified global <span class="hl">payments</span></h3>
          <p>The licensee pays once. We split it across every holder and handle the tax.</p>
        </div>
        <div class="ui">
          <div class="row"><span>One payment in</span><span class="money" data-count="42000" data-prefix="€">€42,000</span></div>
          <div class="row a" style="--i: 0; --d: 900ms"><span>↳ Master side · 100%</span><span>€12,000 paid</span></div>
          <div class="row a" style="--i: 1; --d: 900ms"><span>↳ Publishing side · 50 / 50</span><span>€30,000 paid</span></div>
          <div class="row a" style="--i: 2; --d: 900ms"><span>Taxes withheld &amp; remitted</span><span>€6,750</span></div>
        </div>
      </article>

      <article class="fcard" data-reveal data-play style="--rd: 240ms">
        <div class="text">
          <h3>Clearance pack <span class="hl">delivery</span></h3>
          <p>Broadcast-ready WAVs, stems and the signed license in one download.</p>
        </div>
        <div class="ui">
          {["Master.wav", "Stems.zip", "License.pdf"].map((f, i) => (
            <div class="file a" style={`--i: ${i}`}><span class="ficon" set:html={file} /><span>{f}</span><em>Download</em></div>
          ))}
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .tabs { display: flex; justify-content: center; gap: 6px; width: fit-content; margin: 0 auto clamp(28px, 3.4vw, 44px); padding: 6px; border-radius: 999px; background: var(--surface-2); border: 1px solid var(--line); }
  .tabs button { display: inline-flex; align-items: center; gap: 10px; min-height: 48px; padding: 0 22px; border: 0; border-radius: 999px; background: transparent; color: var(--muted); font: 700 16px var(--font-body); cursor: pointer; transition: background-color .2s, color .2s; }
  .tabs button:hover { color: var(--fg); }
  .tabs .n { font-family: var(--font-display); font-size: 12px; letter-spacing: .1em; color: var(--accent-text); }
  .tabs [aria-selected="true"] { background: #000; color: #fff; }
  .tabs [aria-selected="true"] .n { color: #8b7dff; }
  .tabs button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .cards-grid[hidden] { display: none; }
  @media (max-width: 560px) { .tabs { width: 100%; } .tabs button { flex: 1; justify-content: center; padding: 0 12px; font-size: 14px; } .tabs .n { display: none; } }
</style>

<script>
  import "../scripts/cards";
  import { play } from "../scripts/motion";
  // Two tabs: the arrow keys move between them, and a tab's demos replay when it is shown.
  const list = document.querySelector<HTMLElement>("[data-product-tabs]");
  if (list) {
    const tabs = [...list.querySelectorAll<HTMLButtonElement>("[role=tab]")];
    const select = (i: number, focus = false) => tabs.forEach((t, j) => {
      const on = i === j, panel = document.getElementById(t.getAttribute("aria-controls")!)!;
      t.setAttribute("aria-selected", String(on)); t.tabIndex = on ? 0 : -1;
      panel.hidden = !on;
      if (on) { panel.querySelectorAll<HTMLElement>("[data-play]").forEach(play); if (focus) t.focus(); }
    });
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => select(i));
      t.addEventListener("keydown", (e) => {
        const d = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
        if (d) { e.preventDefault(); select((i + d + tabs.length) % tabs.length, true); }
      });
    });
  }
</script>
