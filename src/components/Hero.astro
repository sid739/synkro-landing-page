---
import { builtFor, demoHref, earlyAccessHref } from "../data/site";
import { syncSegments } from "../data/sync";
import SyncPanel from "./SyncPanel.astro";
---
<section class="stage" id="hero" aria-labelledby="hero-title">
  <div class="viewport" data-viewport>
    <div class="layer">
      <div class="wrap inner">
        <div class="copy" data-copy>
          <p class="eyebrow">For film, TV, ads, trailers, games and streaming</p>
          <h1 id="hero-title" aria-label="Sync Anything">Sync <span class="hl" data-word data-words={JSON.stringify(syncSegments.map((s) => s.cat))}>Anything</span></h1>
          <p class="sub">Search the catalog by <b>brief, reference track or video</b>. See who owns every master and publishing share, then clear it with all of them in one thread.</p>
          <div class="ctas">
            <a class="key" href={demoHref}>Book a 20-min demo <span aria-hidden="true">→</span></a>
            <a class="link" href={earlyAccessHref}>Join the waitlist</a>
          </div>
          <ul class="built" aria-label="Built for">
            <li class="eyebrow">Built for</li>
            {builtFor.map((b) => <li class="pill">{b}</li>)}
          </ul>
          <p class="hint" aria-hidden="true"><i></i>Scroll to search the catalog</p>
        </div>

        <div class="visual" data-visual><SyncPanel /></div>
      </div>
    </div>
  </div>
</section>

<style>
  .stage { --nav: calc(72px + env(safe-area-inset-top, 0px)); position: relative; }
  .viewport { position: relative; height: min(calc(100vh - var(--nav)), 820px); min-height: 600px; overflow: hidden; }
  .layer { position: relative; z-index: 1; height: 100%; display: flex; align-items: center; }
  .inner { position: static; width: 100%; }

  .visual { position: absolute; z-index: 1; top: 50%; transform: translateY(-50%); }
  .copy { max-width: 540px; display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(14px, 2.4vh, 22px); justify-items: start; }
  /* Enough room under "Sync" for its descender to clear the tall letters of every word below it. */
  .copy h1 { font-size: clamp(56px, min(8vw, 15vh), 132px); line-height: 1.04; }
  /* The word changes (Sync Film, Sync TV...); it may run past the column, which keeps its width. */
  .copy h1 .hl { display: block; white-space: nowrap; will-change: transform, opacity; }
  .sub { font-size: clamp(17px, 1.4vw, 20px); line-height: 1.5; color: var(--muted); max-width: 30em; }
  .sub b { color: var(--fg); }
  .ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 22px; }
  .key { display: inline-flex; align-items: center; gap: 10px; min-height: 56px; padding: 0 26px; border-radius: 999px; background: var(--accent); color: #fff; font: 700 17px var(--font-body); text-decoration: none; box-shadow: 0 4px 0 #2f2490; transform: translateY(-2px); transition: transform .15s, box-shadow .15s, background-color .15s; }
  .key:hover { background: #6152e6; transform: translateY(-3px); box-shadow: 0 5px 0 #2f2490; }
  .key:active { transform: translateY(1px); box-shadow: 0 1px 0 #2f2490; }
  .link { font-weight: 700; text-underline-offset: 5px; text-decoration-thickness: 1.5px; min-height: 44px; display: inline-flex; align-items: center; }
  .built { list-style: none; padding: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .built .eyebrow { margin-right: 4px; }
  .built .pill { text-transform: none; letter-spacing: 0; font-family: var(--font-body); font-size: 14px; font-weight: 600; min-height: 36px; padding: 0 14px; }
  .hint { display: inline-flex; align-items: center; gap: 10px; font-size: 13px; color: var(--faint); }
  .hint i { width: 18px; height: 28px; border: 1.5px solid var(--faint); border-radius: 10px; position: relative; }
  .hint i::after { content: ""; position: absolute; left: 50%; top: 5px; width: 3px; height: 6px; margin-left: -1.5px; border-radius: 2px; background: var(--faint); animation: wheel 1.6s ease-in-out infinite; }
  @keyframes wheel { 50% { transform: translateY(6px); opacity: .3; } }


  /* Stacked layout for phones and narrow windows. */
  :global(.hero-static) .viewport { height: auto; min-height: 0; overflow: visible; }
  :global(.hero-static) .layer { height: auto; display: block; padding-block: 48px 72px; }
  :global(.hero-static) .inner { display: grid; gap: 28px; }
  :global(.hero-static) .visual { position: static; transform: none; width: 100%; max-width: 640px; }
  :global(.hero-static) .hint { display: none; }
  @media (prefers-reduced-motion: reduce) { .hint i::after { animation: none; } }
</style>

<script>
  import { initHero } from "../scripts/hero";
  initHero();
</script>
