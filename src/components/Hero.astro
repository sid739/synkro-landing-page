---
import { builtFor, demoHref, earlyAccessHref } from "../data/site";
import { ownershipRing } from "../lib/ring";
import SyncPanel from "./SyncPanel.astro";

// Example search results. Descriptions, not real titles, and labelled as examples on the page.
const results = [
  { desc: "Slow-building strings, lifts in the last 20 seconds", meta: "2019 · 2:48", holders: 1 },
  { desc: "Warm analogue soul groove, brass stabs", meta: "1974 · 3:12", holders: 3, ex: true },
  { desc: "Nocturnal synth pulse, 110 BPM", meta: "2023 · 3:40", holders: 1 },
  { desc: "Sparse piano over rain ambience", meta: "2011 · 2:05", holders: 2 },
  { desc: "Driving post-rock build, big drums", meta: "2008 · 4:22", holders: 4 },
  { desc: "Hazy indie guitar, summer evening", meta: "2016 · 3:01", holders: 1 },
];
---
<section class="stage" id="hero" aria-labelledby="hero-title" data-stage>
  <div class="viewport" data-viewport>
    <div class="layer">
      <div class="wrap inner">
        <div class="copy" data-copy>
          <p class="eyebrow">For film, TV, ads, trailers, games and streaming</p>
          <h1 id="hero-title">Sync <span class="hl">Anything</span></h1>
          <p class="sub">Search the catalog by <b>brief, reference track or video</b>. See who owns every master and publishing share, then clear it with all of them in one thread.</p>
          <div class="ctas">
            <a class="key" href={demoHref}>Book a 20-min demo <span aria-hidden="true">→</span></a>
            <a class="link" href={earlyAccessHref}>Join the waitlist</a>
          </div>
          <ul class="built" aria-label="Built for">
            <li class="eyebrow">Built for</li>
            {builtFor.map((b) => <li class="pill">{b}</li>)}
          </ul>
          <p class="hint" aria-hidden="true"><i></i>Scroll to search the catalog</p>
        </div>

        <div class="visual" data-visual><SyncPanel /></div>

        <div class="results" data-results>
          <div class="top"><p class="eyebrow">01 Search · 02 See rights</p><span class="tag">Example results</span></div>
          <h2>Every result shows who owns it.</h2>
          <ol class="rows">
            {results.map((r) => (
              <li class:list={["r", { ex: r.ex }]}>
                <span class="play" aria-hidden="true"><svg viewBox="0 0 12 12"><path d="M3 1.5v9l7.5-4.5z" /></svg></span>
                <span class="d"><b>{r.desc}</b><small>{r.meta}</small></span>
                <span class:list={["badge", { one: r.holders === 1 }]}>{r.holders === 1 ? "One-stop" : `${r.holders} holders`}</span>
                <svg class="ring" viewBox="0 0 30 30" role="img" aria-label={`${r.holders} rights ${r.holders === 1 ? "holder" : "holders"}`} set:html={ownershipRing(r.holders)} />
              </li>
            ))}
          </ol>
          <p class="foot">AI ranks the results. It doesn't make music, and it never trains on your briefs or the catalog.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .stage { --nav: calc(72px + env(safe-area-inset-top, 0px)); position: relative; height: 240vh; }
  .viewport { position: sticky; top: var(--nav); height: calc(100vh - var(--nav)); overflow: hidden; }
  .layer { position: relative; z-index: 1; height: 100%; display: flex; align-items: center; }
  .inner { position: static; width: 100%; }

  .visual { position: absolute; z-index: 1; top: 50%; transform: translateY(-50%); }
  .copy { max-width: 540px; display: grid; gap: clamp(14px, 2.4vh, 22px); justify-items: start; will-change: opacity, transform; }
  .copy h1 { font-size: clamp(56px, min(8vw, 15vh), 132px); line-height: .88; }
  .copy h1 .hl { display: block; }
  .sub { font-size: clamp(17px, 1.4vw, 20px); line-height: 1.5; color: var(--muted); max-width: 30em; }
  .sub b { color: var(--fg); }
  .ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 22px; }
  .key { display: inline-flex; align-items: center; gap: 10px; min-height: 56px; padding: 0 26px; border-radius: 999px; background: var(--accent); color: #fff; font: 700 17px var(--font-body); text-decoration: none; box-shadow: 0 4px 0 #2f2490; transform: translateY(-2px); transition: transform .15s, box-shadow .15s, background-color .15s; }
  .key:hover { background: #6152e6; transform: translateY(-3px); box-shadow: 0 5px 0 #2f2490; }
  .key:active { transform: translateY(1px); box-shadow: 0 1px 0 #2f2490; }
  .link { font-weight: 700; text-underline-offset: 5px; text-decoration-thickness: 1.5px; min-height: 44px; display: inline-flex; align-items: center; }
  .built { list-style: none; padding: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .built .eyebrow { margin-right: 4px; }
  .built .pill { text-transform: none; letter-spacing: 0; font-family: var(--font-body); font-size: 14px; font-weight: 600; min-height: 36px; padding: 0 14px; }
  .hint { display: inline-flex; align-items: center; gap: 10px; font-size: 13px; color: var(--faint); }
  .hint i { width: 18px; height: 28px; border: 1.5px solid var(--faint); border-radius: 10px; position: relative; }
  .hint i::after { content: ""; position: absolute; left: 50%; top: 5px; width: 3px; height: 6px; margin-left: -1.5px; border-radius: 2px; background: var(--faint); animation: wheel 1.6s ease-in-out infinite; }
  @keyframes wheel { 50% { transform: translateY(6px); opacity: .3; } }


  .results { position: absolute; z-index: 1; left: max(var(--gutter), calc((100% - var(--max)) / 2 + 16px)); top: 50%; transform: translateY(-50%); width: min(600px, 50%); display: grid; gap: 14px; opacity: 0; pointer-events: none; }
  .results h2 { font-size: clamp(32px, 3.4vw, 50px); }
  .top { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .tag { font-size: 12px; font-weight: 700; color: var(--muted); padding: 4px 10px; border: 1px solid var(--line); border-radius: 999px; white-space: nowrap; }
  .rows { list-style: none; padding: 0; display: grid; gap: 8px; }
  .r { display: grid; grid-template-columns: 34px minmax(0, 1fr) auto auto; align-items: center; gap: 14px; padding: 11px 14px; border-radius: 14px; background: var(--surface); border: 1px solid var(--line); }
  .r.ex { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 12%, var(--surface)); }
  .d { min-width: 0; display: grid; line-height: 1.3; }
  .d b { font-size: 15px; overflow-wrap: anywhere; }
  .d small { color: var(--muted); font-size: 13px; font-variant-numeric: tabular-nums; }
  .badge { font-size: 12px; font-weight: 700; padding: 4px 10px; border-radius: 999px; background: var(--surface-2); color: var(--muted); white-space: nowrap; }
  .badge.one { color: var(--accent-text); }
  .ring { width: 30px; height: 30px; }
  .ring :global(circle) { fill: none; stroke-width: 3.6; }
  .ring :global(.bg) { stroke: var(--line); }
  .ring :global(.arc) { stroke: var(--accent-text); }
  .r.ex .ring :global(.arc) { stroke: var(--fg); }
  .play { width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; background: var(--surface-2); }
  .play svg { width: 12px; height: 12px; fill: var(--fg); }
  .r.ex .play { background: var(--accent); }
  .r.ex .play svg { fill: #fff; }
  .foot { font-size: 13px; color: var(--muted); }

  /* Stacked layout for phones and reduced motion. */
  :global(.hero-static) .stage { height: auto; }
  :global(.hero-static) .viewport { position: relative; top: 0; height: auto; overflow: visible; }
  :global(.hero-static) .layer { height: auto; display: block; padding-block: 48px 72px; }
  :global(.hero-static) .inner { display: grid; gap: 28px; }
  :global(.hero-static) .visual { position: static; transform: none; width: 100%; max-width: 640px; }
  :global(.hero-static) .copy { opacity: 1 !important; transform: none !important; visibility: visible !important; }
  :global(.hero-static) .results { position: static; transform: none !important; width: 100%; max-width: 640px; opacity: 1 !important; pointer-events: auto !important; margin-top: 20px; }
  :global(.hero-static) .hint { display: none; }
  @media (max-width: 560px) { .r { grid-template-columns: 34px minmax(0, 1fr) auto; } .badge { display: none; } }
  @media (prefers-reduced-motion: reduce) { .hint i::after { animation: none; } }
</style>

<script>
  import { initHero } from "../scripts/hero";
  initHero();
</script>
